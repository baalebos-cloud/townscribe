{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path((?!ads\\.txt$|robots\\.txt$).*)",
      "has": [{ "type": "host", "value": "www.townscribe.org" }],
      "destination": "https://news.townscribe.org/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!ads\\.txt$|robots\\.txt$).*)",
      "has": [{ "type": "host", "value": "townscribe.org" }],
      "destination": "https://news.townscribe.org/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/404"
    }
  ]
}
