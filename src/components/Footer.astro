---
import { CATEGORIES } from '../categories';
import { SOCIAL_LINKS, WHATSAPP_CHANNEL_URL } from '../consts';
import SocialIcon from './SocialIcon.astro';
import TvIcon from './TvIcon.astro';

const today = new Date();
const half = Math.ceil(CATEGORIES.length / 2);
const columns = [CATEGORIES.slice(0, half), CATEGORIES.slice(half)];
---

<footer class="foot">
	<div class="wrap">
		<div class="cols">
			<div class="about">
				<a class="brand" href="/" aria-label="TownScribe Media home">
					<img src="/townscribe-img.jpg" alt="" width="40" height="40" loading="lazy" />
					<span>TownScribe</span>
				</a>
				<p>Independent Nigerian news on politics, governance, crime, business, sport and lifestyle. Where every story breathes.</p>
				<div class="social-links">
					{SOCIAL_LINKS.filter((l) => l.id !== 'youtube').map((l) => (
						<a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={`TownScribe on ${l.label}`} title={l.label}>
							<SocialIcon id={l.id} size={20} />
						</a>
					))}
					<a href="/tv" aria-label="TownScribe TV" title="TownScribe TV">
						<TvIcon size={22} />
					</a>
				</div>
				<a class="wa-cta" href={WHATSAPP_CHANNEL_URL} target="_blank" rel="noopener noreferrer">
					<SocialIcon id="whatsapp" size={18} /> Follow our WhatsApp Channel
				</a>
			</div>

			{columns.map((col, i) => (
				<nav aria-label={i === 0 ? 'Sections' : 'More sections'}>
					<h2>{i === 0 ? 'Sections' : 'More'}</h2>
					<ul>
						{col.map((c) => <li><a href={`/category/${c.slug}`}>{c.label}</a></li>)}
					</ul>
				</nav>
			))}

			{/* AdSense requires these pages to be easy to reach */}
			<nav class="footer-nav" aria-label="TownScribe">
				<h2>TownScribe</h2>
				<ul>
					<li><a href="/tv">TownScribe TV</a></li>
					<li><a href="/about">About Us</a></li>
					<li><a href="/contact">Contact</a></li>
					<li><a href="/privacy-policy">Privacy Policy</a></li>
					<li><a href="/terms-of-service">Terms of Service</a></li>
				</ul>
			</nav>
		</div>

		<div class="legal">
			<span>&copy; {today.getFullYear()} TownScribe Media. All rights reserved.</span>
			<a href="/rss.xml">RSS feed</a>
		</div>
	</div>
</footer>

<style>
	.foot {
		background: var(--brand);
		color: var(--brand-ink);
		padding-block: 2.5rem calc(2rem + env(safe-area-inset-bottom, 0px));
		margin-top: 3rem;
		font-size: 0.9rem;
	}
	.cols {
		display: grid;
		grid-template-columns: 1.6fr repeat(3, 1fr);
		gap: 2rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--brand-ink);
		font: 900 1.35rem/1 var(--font-head);
		letter-spacing: -0.02em;
	}
	.brand img {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		object-fit: cover;
	}
	.about p {
		opacity: 0.8;
		margin: 0.9rem 0 1rem;
		max-width: 36ch;
	}
	h2 {
		font: 700 0.72rem var(--font-ui);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--brand-ink);
		opacity: 0.65;
		margin: 0 0 0.8rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}
	a {
		color: var(--brand-ink);
		opacity: 0.88;
	}
	a:hover {
		color: var(--brand-ink);
		opacity: 1;
		text-decoration: underline;
	}
	.social-links {
		display: flex;
		gap: 1.1rem;
		align-items: center;
	}
	.social-links a {
		display: inline-flex;
	}
	.wa-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 1rem;
		padding: 0.55rem 1rem;
		border-radius: 999px;
		background: #1f8f4e;
		color: #fff;
		opacity: 1;
		font-weight: 700;
		font-size: 0.85rem;
	}
	.wa-cta:hover {
		background: #18763f;
		text-decoration: none;
		color: #fff;
	}
	.legal {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		margin-top: 2rem;
		padding-top: 1rem;
		font-size: 0.8rem;
		opacity: 0.8;
	}
	@media (max-width: 760px) {
		.cols {
			grid-template-columns: 1fr 1fr;
		}
		.about {
			grid-column: 1 / -1;
		}
	}
</style>
