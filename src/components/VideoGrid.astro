---
// Grid of video cards. On /tv (inlinePlay) a click plays the video in the
// page's main player; elsewhere cards link to the video's page.
import type { Video } from '../youtube';
import FormattedDate from './FormattedDate.astro';

interface Props {
	videos: Video[];
	inlinePlay?: boolean;
	/** Light text for the dark TownScribe TV band */
	dark?: boolean;
}

const { videos, inlinePlay = false, dark = false } = Astro.props;
---

<ul class:list={["video-grid", { dark }]}>
	{videos.map((v) => (
		<li>
			<a
				class="video-card"
				href={v.href}
				data-inline-play={inlinePlay && !v.href.startsWith('/tv/') ? 'true' : undefined}
				data-id={v.id}
				data-url={v.youtubeUrl}
				data-live={v.live ? 'true' : 'false'}
				data-title={v.title}
			>
				<div class="thumb">
					<img src={v.thumbnail} alt="" width="480" height="270" loading="lazy" decoding="async" />
					{v.live ? <span class="live">● LIVE</span> : <span class="play" aria-hidden="true">▶</span>}
				</div>
				<h3>{v.title}</h3>
				<p class="date">{v.live ? 'Live now' : <FormattedDate date={v.published} />}{!v.live && ' · 15s preview'}</p>
			</a>
		</li>
	))}
</ul>

{inlinePlay && (
	<script>
		document.querySelectorAll<HTMLAnchorElement>('a[data-inline-play]').forEach((a) => {
			a.addEventListener('click', (e) => {
				if (!window.tsPlayVideo || e.metaKey || e.ctrlKey) return;
				e.preventDefault();
				const { id, url, live, title } = a.dataset;
				window.tsPlayVideo({ id: id!, url, live: live === 'true', title });
				history.replaceState(null, '', `/tv?v=${id}`);
			});
		});
	</script>
)}

<style>
	.video-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px 20px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.video-card {
		display: grid;
		gap: 8px;
		color: var(--ink);
	}
	.thumb {
		position: relative;
		border-radius: 6px;
		overflow: hidden;
		background: #000;
	}
	.thumb img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.25s ease, opacity 0.2s ease;
	}
	.video-card:hover img {
		transform: scale(1.03);
		opacity: 0.9;
	}
	.play {
		position: absolute;
		left: 10px;
		bottom: 10px;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--red);
		color: #fff;
		display: grid;
		place-items: center;
		font-size: 0.7rem;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}
	.live {
		position: absolute;
		left: 10px;
		top: 10px;
		background: var(--red);
		color: #fff;
		font: 800 0.68rem/1 var(--font-ui);
		letter-spacing: 0.08em;
		padding: 6px 8px;
		border-radius: 3px;
	}
	h3 {
		font-size: 0.98rem;
		line-height: 1.3;
		font-weight: 700;
		margin: 0;
		color: inherit;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.video-card:hover h3 {
		color: var(--red);
	}
	.date {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.dark .video-card {
		color: var(--tv-ink);
	}
	.dark .video-card:hover h3 {
		color: #ff9aa8;
	}
	.dark .date {
		color: var(--tv-muted);
	}
	@media (max-width: 980px) {
		.video-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 480px) {
		.video-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
