---
// "TownScribe TV" television icon (replaces the YouTube logo across the site).
interface Props {
	size?: number;
}
const { size = 24 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	<rect x="2" y="7" width="20" height="14" rx="2.5"></rect>
	<polyline points="17 2 12 7 7 2"></polyline>
	<polygon points="10 11 15 14 10 17" fill="currentColor" stroke="none"></polygon>
</svg>
