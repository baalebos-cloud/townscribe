---
// YouTube player used on articles, TV posts and /tv.
// - Shows a thumbnail first; the YouTube player only loads when someone presses play.
// - Normal videos play PREVIEW_SECONDS, show a countdown, then continue on YouTube.
// - Live streams (live = true) play in full on the site.
// Other scripts can switch the video with window.tsPlayVideo({ id, url, live, title, autoplay }).
import { PREVIEW_SECONDS, thumbUrl, watchUrl } from '../youtube-id';

interface Props {
	videoId: string;
	youtubeUrl?: string;
	live?: boolean;
	title?: string;
	thumbnail?: string;
}

const { videoId, youtubeUrl, live = false, title = 'Play video', thumbnail } = Astro.props;
// Keep the writer's link (it may carry a start time) only if it is a full URL
const redirectUrl = youtubeUrl && /^https?:\/\//.test(youtubeUrl.trim()) ? youtubeUrl.trim() : watchUrl(videoId);
---

<div
	class="ts-player"
	data-id={videoId}
	data-url={redirectUrl}
	data-live={live ? 'true' : 'false'}
	data-preview={PREVIEW_SECONDS}
>
	<button class="ts-player-poster" type="button" aria-label={`Play: ${title}`}>
		<img src={thumbnail || thumbUrl(videoId)} alt="" loading="lazy" decoding="async" width="480" height="360" />
		<span class="ts-player-play" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
		</span>
		<span class="ts-player-badge" data-live-badge hidden={!live}>● LIVE</span>
		<span class="ts-player-note" data-preview-note hidden={live}>{PREVIEW_SECONDS}s preview · full video on YouTube</span>
	</button>
	<div class="ts-player-frame" hidden></div>
	<div class="ts-player-countdown" hidden>Continuing on YouTube in <b>5</b>s…</div>
</div>

<script>
	type YTPlayer = { getCurrentTime(): number; pauseVideo(): void; loadVideoById(id: string): void; destroy(): void };
	declare global {
		interface Window {
			YT?: any;
			onYouTubeIframeAPIReady?: () => void;
			tsPlayVideo?: (v: { id: string; url?: string; live?: boolean; title?: string; autoplay?: boolean }) => void;
		}
	}

	let apiPromise: Promise<void> | undefined;
	function loadApi(): Promise<void> {
		apiPromise ??= new Promise((resolve) => {
			if (window.YT?.Player) return resolve();
			const previous = window.onYouTubeIframeAPIReady;
			window.onYouTubeIframeAPIReady = () => {
				previous?.();
				resolve();
			};
			const s = document.createElement('script');
			s.src = 'https://www.youtube.com/iframe_api';
			document.head.appendChild(s);
		});
		return apiPromise;
	}

	function setup(root: HTMLElement) {
		const poster = root.querySelector<HTMLButtonElement>('.ts-player-poster')!;
		const frame = root.querySelector<HTMLElement>('.ts-player-frame')!;
		const countdown = root.querySelector<HTMLElement>('.ts-player-countdown')!;
		let player: YTPlayer | null = null;
		let timer: number | undefined;

		const state = () => ({
			id: root.dataset.id!,
			url: root.dataset.url!,
			live: root.dataset.live === 'true',
			preview: Number(root.dataset.preview) || 15,
		});

		function stopTimer() {
			if (timer) window.clearInterval(timer);
			timer = undefined;
		}

		function goToYouTube(seconds: number) {
			stopTimer();
			const { url } = state();
			const target = new URL(url);
			if (!target.searchParams.has('t')) target.searchParams.set('t', `${Math.floor(seconds)}s`);
			window.location.href = target.toString();
		}

		function watch() {
			stopTimer();
			const { live, preview } = state();
			if (live || !player) return;
			timer = window.setInterval(() => {
				const t = player?.getCurrentTime?.() ?? 0;
				const left = Math.ceil(preview - t);
				if (left <= 5 && left > 0) {
					countdown.hidden = false;
					countdown.querySelector('b')!.textContent = String(left);
				}
				if (t >= preview) {
					player?.pauseVideo();
					goToYouTube(t);
				}
			}, 250);
		}

		async function play() {
			const { id } = state();
			poster.hidden = true;
			frame.hidden = false;
			countdown.hidden = true;
			await loadApi();
			if (player) {
				player.loadVideoById(id);
				return;
			}
			const mount = document.createElement('div');
			frame.replaceChildren(mount);
			player = new window.YT.Player(mount, {
				videoId: id,
				playerVars: { autoplay: 1, playsinline: 1, rel: 0, modestbranding: 1 },
				events: {
					onStateChange: (e: { data: number }) => {
						const S = window.YT.PlayerState;
						if (e.data === S.PLAYING) watch();
						else if (e.data === S.ENDED && !state().live) goToYouTube(0);
						else stopTimer();
					},
				},
			});
		}

		poster.addEventListener('click', play);

		// Lets the /tv grid switch the main player to another video
		window.tsPlayVideo = ({ id, url, live = false, title, autoplay = true }) => {
			stopTimer();
			root.dataset.id = id;
			root.dataset.url = url || `https://www.youtube.com/watch?v=${id}`;
			root.dataset.live = String(live);
			root.querySelector<HTMLElement>('[data-live-badge]')!.hidden = !live;
			root.querySelector<HTMLElement>('[data-preview-note]')!.hidden = live;
			if (title) poster.setAttribute('aria-label', `Play: ${title}`);
			document.dispatchEvent(new CustomEvent('ts-video-change', { detail: { id, url: root.dataset.url, live, title } }));
			if (!autoplay) {
				// Just show this video's thumbnail; it starts when the viewer presses play
				poster.querySelector('img')!.src = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
				return;
			}
			root.scrollIntoView({ behavior: 'smooth', block: 'center' });
			void play();
		};
	}

	document.querySelectorAll<HTMLElement>('.ts-player').forEach(setup);
</script>

<style>
	.ts-player {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
	}
	.ts-player-poster {
		all: unset;
		position: absolute;
		inset: 0;
		cursor: pointer;
		display: block;
	}
	.ts-player-poster img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		opacity: 0.9;
	}
	.ts-player-play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: rgba(220, 38, 38, 0.95);
		color: #fff;
		display: grid;
		place-items: center;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
		transition: transform 0.15s ease;
	}
	.ts-player-poster:hover .ts-player-play,
	.ts-player-poster:focus-visible .ts-player-play {
		transform: translate(-50%, -50%) scale(1.08);
	}
	.ts-player-poster:focus-visible {
		outline: 3px solid #14b8a6;
		outline-offset: -3px;
	}
	.ts-player-badge {
		position: absolute;
		top: 12px;
		left: 12px;
		background: #dc2626;
		color: #fff;
		font: 700 0.75rem/1 system-ui, sans-serif;
		letter-spacing: 0.06em;
		padding: 0.4rem 0.6rem;
		border-radius: 4px;
	}
	.ts-player-note {
		position: absolute;
		bottom: 12px;
		left: 12px;
		background: rgba(0, 0, 0, 0.7);
		color: #fff;
		font: 500 0.8rem/1.2 system-ui, sans-serif;
		padding: 0.35rem 0.6rem;
		border-radius: 4px;
	}
	.ts-player-frame,
	.ts-player-frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.ts-player-countdown {
		position: absolute;
		bottom: 14px;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(220, 38, 38, 0.97);
		color: #fff;
		padding: 0.55rem 1.2rem;
		border-radius: 999px;
		font: 600 0.9rem/1.2 system-ui, sans-serif;
		white-space: nowrap;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
		pointer-events: none;
	}
	[hidden] {
		display: none !important;
	}
</style>
