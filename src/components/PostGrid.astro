---
// Grid of story cards used by listings (/blog, categories) and homepage sections.
import StoryCard from './StoryCard.astro';
import type { Post } from '../posts';

interface Props {
	posts: Post[];
	/** Show the category label on each card (off on category pages) */
	showCategory?: boolean;
	/** How many leading images load eagerly (above the fold) */
	eager?: number;
}

const { posts, showCategory = true, eager = 0 } = Astro.props;
---

<ul class="post-grid">
	{posts.map((post, i) => (
		<li>
			<StoryCard post={post} showCategory={showCategory} eager={i < eager} />
		</li>
	))}
</ul>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 28px 22px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	@media (max-width: 980px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.post-grid {
			grid-template-columns: 1fr;
			gap: 16px;
		}
	}
</style>
