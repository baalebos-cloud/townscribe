---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/townscribe-img.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string; // Updated to accept standard strings or dynamic metadata shapes cleanly
	seoTitle?: string;
	seoDescription?: string;
	seoKeyword?: string;
	robotsIndex?: string;
	author?: string;
	pubDate?: Date;
	category?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { 
	title, 
	description, 
	image = FallbackImage, 
	seoTitle, 
	seoDescription,
	seoKeyword,
	robotsIndex = 'index, follow',
	author = 'TownScribe Staff',
	pubDate,
	category = 'News'
} = Astro.props;

// Fallback logic: Use the custom SEO fields if the writer sets them, otherwise use standard titles
const finalTitle = seoTitle || title;
const finalDescription = seoDescription || description;

// Safely extract the exact URL string whether it's an Astro media object or a flat public asset path
const finalImageUrl = typeof image === 'string' 
	? new URL(image, Astro.site) 
	: new URL(image.src, Astro.site);
---

<!-- Global Metadata Elements -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Advanced Search Engine Directives -->
<link rel="canonical" href={canonicalURL} />
<title>{finalTitle}</title>
<meta name="title" content={finalTitle} />
<meta name="description" content={finalDescription} />
{seoKeyword && <meta name="keywords" content={seoKeyword} />}
<meta name="robots" content={robotsIndex} />

<!-- Open Graph / Facebook Meta Cards -->
<meta property="og:type" content={pubDate ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={finalImageUrl} />
<meta property="og:site_name" content="TownScribe News" />

<!-- Twitter / X Meta Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={finalTitle} />
<meta property="twitter:description" content={finalDescription} />
<meta property="twitter:image" content={finalImageUrl} />

{/* 
  --- ENGINE INJECTION: GOOGLE RICH SNIPPET STRUCTURED DATA (JSON-LD) ---
  Generates automated structured news schemas when viewing specific markdown posts!
*/}
{pubDate && (
	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "NewsArticle",
		"headline": finalTitle,
		"image": [finalImageUrl.href],
		"datePublished": pubDate instanceof Date ? pubDate.toISOString() : pubDate,
		"dateModified": pubDate instanceof Date ? pubDate.toISOString() : pubDate,
		"author": [{
			"@type": "Person",
			"name": author,
			"url": canonicalURL.origin
		}],
		"publisher": {
			"@type": "Organization",
			"name": "TownScribe",
			"logo": {
				"@type": "ImageObject",
				"url": new URL('/townscribe-img.jpg', Astro.site).href
			}
		},
		"description": finalDescription,
		"articleSection": category
	})} />
)}
