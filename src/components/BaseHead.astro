---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/townscribe-img.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	seoTitle?: string;
	seoDescription?: string;
	seoKeyword?: string;
	author?: string;
	pubDate?: Date;
	category?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { 
	title, 
	description, 
	image = FallbackImage, 
	seoTitle, 
	seoDescription,
	seoKeyword,
	author = 'TownScribe Staff',
	pubDate,
	category = 'News'
} = Astro.props;

// --- AUTOMATED ENGINE: FINALIZE INDEXING DIRECTIVE ---
// If the writer filled out all SEO panel requirements, allow indexing. Otherwise, protect the site.
const automatedRobotsIndex = (seoTitle && seoDescription && seoKeyword) 
	? 'index, follow' 
	: 'noindex, nofollow';

const finalTitle = seoTitle || title;
const finalDescription = seoDescription || description;

const finalImageUrl = typeof image === 'string' 
	? new URL(image, Astro.site) 
	: new URL(image.src, Astro.site);
---

<!-- Global Metadata Elements -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/jpeg" href="/townscribe-img.jpg" />
<link rel="apple-touch-icon" href="/townscribe-img.jpg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Advanced Search Engine Directives -->
<link rel="canonical" href={canonicalURL} />
<title>{finalTitle}</title>
<meta name="title" content={finalTitle} />
<meta name="description" content={finalDescription} />
{seoKeyword && <meta name="keywords" content={seoKeyword} />}

<!-- AUTOMATED ROBOTS STATE DIRECTIVE -->
<meta name="robots" content={automatedRobotsIndex} />

<!-- Open Graph / Facebook Meta Cards -->
<meta property="og:type" content={pubDate ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={finalImageUrl} />
<meta property="og:site_name" content="TownScribe News" />

<!-- Twitter / X Meta Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={finalTitle} />
<meta property="twitter:description" content={finalDescription} />
<meta property="twitter:image" content={finalImageUrl} />

{/* --- AUTOMATED STRUCTURED DATA SNIPPET (JSON-LD) --- */}
{pubDate && (
	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "NewsArticle",
		"headline": finalTitle,
		"image": [finalImageUrl.href],
		"datePublished": pubDate instanceof Date ? pubDate.toISOString() : pubDate,
		"dateModified": pubDate instanceof Date ? pubDate.toISOString() : pubDate,
		"author": [{
			"@type": "Person",
			"name": author,
			"url": canonicalURL.origin
		}],
		"publisher": {
			"@type": "Organization",
			"name": "TownScribe",
			"logo": {
				"@type": "ImageObject",
				"url": new URL('/townscribe-img.jpg', Astro.site).href
			}
		},
		"description": finalDescription,
		"articleSection": category
	})} />
)}

<!-- WEB PUSH NOTIFICATION ENGINE -->
<script is:inline>
    const WORKER_URL = 'https://townscribe-push-worker.jayeolaoluwadamilare.workers.dev';

    function urlBase64ToUint8Array(base64String) {
        const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
        const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
        const rawData = atob(base64);
        return new Uint8Array([...rawData].map(c => c.charCodeAt(0)));
    }

    async function subscribeToPush() {
        if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
            alert('Push notifications are not supported in this browser.');
            return;
        }

        const permission = await Notification.requestPermission();
        if (permission !== 'granted') return;

        try {
            const reg = await navigator.serviceWorker.ready;
            const { key } = await fetch(`${WORKER_URL}/vapid-public-key`).then(r => r.json());

            const subscription = await reg.pushManager.subscribe({
                userVisibleOnly: true,
                applicationServerKey: urlBase64ToUint8Array(key)
            });

            await fetch(`${WORKER_URL}/subscribe`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(subscription)
            });

            localStorage.setItem('ts_push_subscribed', 'true');
            updateButtonState(true);
            alert('You are now subscribed to TownScribe news alerts!');
        } catch (err) {
            console.error('[TownScribe] Push subscription failed:', err);
            alert('Failed to subscribe. Please try again.');
        }
    }

    function updateButtonState(subscribed) {
        const btn = document.getElementById('push-subscribe-btn');
        if (!btn) return;
        if (subscribed) {
            btn.textContent = '✅';
            btn.classList.add('subscribed');
            btn.title = 'Already subscribed to TownScribe news alerts';
        } else {
            btn.textContent = '🔔';
            btn.classList.remove('subscribed');
            btn.title = 'Get news alerts';
        }
    }

    async function initPush() {
        if (!('serviceWorker' in navigator)) return;

        // Register service worker
        await navigator.serviceWorker.register('/sw.js').catch(err => {
            console.error('[TownScribe] Service worker registration failed:', err);
        });

        const btn = document.getElementById('push-subscribe-btn');
        if (!btn) return;

        // Check existing subscription state
        try {
            const reg = await navigator.serviceWorker.ready;
            const existing = await reg.pushManager.getSubscription();
            updateButtonState(!!(existing || localStorage.getItem('ts_push_subscribed')));
        } catch {
            // Non-fatal — button stays in default state
        }

        btn.addEventListener('click', async () => {
            try {
                const reg = await navigator.serviceWorker.ready;
                const existing = await reg.pushManager.getSubscription();
                if (existing) {
                    alert('You are already subscribed to TownScribe news alerts!');
                    return;
                }
                await subscribeToPush();
            } catch (err) {
                console.error('[TownScribe] Push init error:', err);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPush);
    } else {
        initPush();
    }
</script>