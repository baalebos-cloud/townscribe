---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="main-navigation">
		{/* Top Primary Branding & Core Links Row */}
		<div class="brand-row">
			<div class="left-brand-group">
				<button id="menu-toggle" class="menu-btn" aria-label="Toggle Categories Menu">
					<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5">
						<line x1="3" y1="12" x2="21" y2="12"></line>
						<line x1="3" y1="6" x2="21" y2="6"></line>
						<line x1="3" y1="18" x2="21" y2="18"></line>
					</svg>
				</button>
				<h2><a href="/">{SITE_TITLE}</a></h2>
			</div>
			
			{/* Your Original Main Internal Links remain untouched here */}
			<div class="internal-links">
				<HeaderLink href="/blog">Blog</HeaderLink>
			</div>

			<div class="social-links">
				<a href="https://www.instagram.com/townscribenews?igsh=MTZxM3p1b3Bub2s2ag==" target="_blank">
					<span class="sr-only">Follow Townscribe on Instagram</span>
					<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"></path></svg>
				</a>
				<a href="https://x.com/townscribenews?s=21" target="_blank">
					<span class="sr-only">Follow Townscribe on Twitter</span>
					<svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path></svg>
				</a>
			</div>
		</div>

		{/* Left Sidebar Drawer - Only containing your specified news categories */}
		<div id="nav-drawer" class="nav-drawer">
			<div class="drawer-header">
				<span class="drawer-title">Sign in</span>
				<button id="menu-close" class="close-btn" aria-label="Close Menu">
					<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			
			<div class="drawer-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/">About</HeaderLink>
				<HeaderLink href="/category/politics">Politics</HeaderLink>
				<HeaderLink href="/category/business">Business</HeaderLink>
				<HeaderLink href="/category/entertainment">Entertainment</HeaderLink>
				<HeaderLink href="/category/technology">Technology</HeaderLink>
				<HeaderLink href="/category/health">Health</HeaderLink>
				<HeaderLink href="/category/sport">Sport</HeaderLink>
				<HeaderLink href="/category/world">World</HeaderLink>
				<HeaderLink href="/category/job">Job</HeaderLink>
			</div>
		</div>
		
		{/* Dark backdrop overlay overlay */}
		<div id="drawer-overlay" class="drawer-overlay"></div>
	</nav>
</header>

<script>
	const openBtn = document.getElementById('menu-toggle');
	const closeBtn = document.getElementById('menu-close');
	const drawer = document.getElementById('nav-drawer');
	const overlay = document.getElementById('drawer-overlay');

	function toggleMenu() {
		drawer?.classList.toggle('open');
		overlay?.classList.toggle('active');
		document.body.classList.toggle('menu-lock');
	}

	openBtn?.addEventListener('click', toggleMenu);
	closeBtn?.addEventListener('click', toggleMenu);
	overlay?.addEventListener('click', toggleMenu);
</script>

<style>
	header {
		margin: 0;
		padding: 0;
		background: #ffffff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 5%);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.main-navigation {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	.brand-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.left-brand-group {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
	}
	h2 a {
		color: #000;
		text-decoration: none;
	}
	.menu-btn {
		background: none;
		border: none;
		color: #000;
		cursor: pointer;
		padding: 0.5rem 0.25rem;
		display: flex;
		align-items: center;
	}

	/* --- Top Bar Classic Horizontal Links Configuration --- */
	.internal-links {
		display: flex;
	}
	.internal-links :global(a) {
		padding: 1rem 0.5rem;
		color: #000;
		text-decoration: none;
		border-bottom: 4px solid transparent;
	}
	.internal-links :global(a.active) {
		border-bottom-color: var(--accent, #14b8a6);
	}

	/* --- LEFT SIDEBAR DRAWER (Dark Theme UI - image_de3fa4.jpg) --- */
	.nav-drawer {
		position: fixed;
		top: 0;
		left: -320px;
		width: 300px;
		height: 100vh;
		background: #142129; /* Matches image_de3fa4.jpg background hue */
		z-index: 200;
		display: flex;
		flex-direction: column;
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
		padding: 1.5rem;
		box-shadow: 4px 0 24px rgba(0, 0, 0, 0.3);
	}
	.nav-drawer.open {
		transform: translateX(320px);
	}
	.drawer-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2.5rem;
	}
	.drawer-title {
		color: #ffffff;
		font-weight: 600;
		font-size: 1.15rem;
	}
	.close-btn {
		background: none;
		border: none;
		color: #ffffff;
		cursor: pointer;
		padding: 0.25rem;
	}

	/* Vertically stacked category link columns inside drawer */
	.drawer-links {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.drawer-links :global(a) {
		color: #ffffff;
		font-size: 1.3rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.15s ease;
		padding: 0.15rem 0;
		display: block;
	}
	.drawer-links :global(a.active),
	.drawer-links :global(a:hover) {
		color: #14b8a6; /* Active color state indicator matched from image_de3fa4.jpg */
		font-weight: 600;
	}

	/* Transparent blur cover overlay behind sidebar drawer */
	.drawer-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: rgba(0, 0, 0, 0.4);
		backdrop-filter: blur(1.5px);
		z-index: 150;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}
	.drawer-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.social-links {
		display: flex;
		gap: 0.75rem;
	}
	.social-links a {
		color: #000;
	}

	:global(body.menu-lock) {
		overflow: hidden;
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
