---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const AUTH_API = 'https://townscribe-auth.jayeolaoluwadamilare.workers.dev';
---

<header>
	<nav class="main-navigation">
		<div class="brand-row">
			<div class="left-brand-group">
				<button id="menu-toggle" class="menu-btn" aria-label="Toggle Categories Menu">
					<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5">
						<line x1="3" y1="12" x2="21" y2="12"></line>
						<line x1="3" y1="6" x2="21" y2="6"></line>
						<line x1="3" y1="18" x2="21" y2="18"></line>
					</svg>
				</button>
				
				<!-- Optimized Wrapper ensuring both Text and Graphic Fallbacks render cleanly -->
				<div class="brand-logo-wrapper">
					<a href="/" aria-label="TownScribe Media Home">
						<img 
							src="/townscribe-img.jpg" 
							alt="TownScribe Media Logo" 
							class="site-logo-graphic"
							onerror="this.style.display='none'; document.getElementById('text-fallback').style.display='inline-block';"
						/>
						<span id="text-fallback" class="site-title-text">TownScribe Media</span>
					</a>
				</div>
			</div>
			
			<div class="internal-links">
				<HeaderLink href="/">Media</HeaderLink>
			</div>

			<div class="right-actions">
				<div class="social-links">
					<a href="https://www.instagram.com/townscribenews?igsh=MTZxM3p1b3Bub2s2ag==" target="_blank" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
					</a>
					<a href="https://x.com/townscribenews?s=21" target="_blank" aria-label="X (Twitter)">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</a>
					<a href="https://www.youtube.com/@townscribeTV" target="_blank" aria-label="YouTube">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
					</a>
				</div>

				<!-- AUTH CONTROLS -->
				<div class="auth-controls">
					<button id="auth-signin-btn" class="auth-btn signin-btn" style="display:none;">Sign In</button>

					<div id="user-menu" class="user-menu" style="display:none;">
						<button id="user-avatar-btn" class="user-avatar-btn" aria-label="User menu">
							<div id="user-avatar-display" class="avatar-circle">?</div>
						</button>
						<div id="user-dropdown" class="user-dropdown" style="display:none;">
							<div class="dropdown-header">
								<span id="dropdown-name" class="dropdown-name"></span>
								<span id="dropdown-email" class="dropdown-email"></span>
							</div>
							<hr class="dropdown-divider" />
							<a href="/bookmarks" class="dropdown-item">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
								My Bookmarks
							</a>
							<a href="/profile" class="dropdown-item">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
								Profile
							</a>
							<hr class="dropdown-divider" />
							<button id="signout-btn" class="dropdown-item signout-item">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
								Sign Out
							</button>
						</div>
					</div>
				</div>

				<button id="push-subscribe-btn" class="push-notify-btn" title="Get news alerts">🔔</button>
			</div>
		</div>

		<div id="nav-drawer" class="nav-drawer">
			<div class="drawer-header">
				<span class="drawer-title">Menu</span>
				<button id="menu-close" class="close-btn" aria-label="Close Menu">
					<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
				</button>
			</div>
			<div class="drawer-links">
				<HeaderLink href="/home">Home</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<hr class="drawer-divider" />
				<HeaderLink href="/category/news">News</HeaderLink>
				<HeaderLink href="/category/politics">Politics</HeaderLink>
				<HeaderLink href="/category/business">Business</HeaderLink>
				<HeaderLink href="/category/entertainment">Entertainment</HeaderLink>
				<HeaderLink href="/category/technology">Technology</HeaderLink>
				<HeaderLink href="/category/health">Health</HeaderLink>
				<HeaderLink href="/category/sport">Sport</HeaderLink>
				<HeaderLink href="/category/world">World</HeaderLink>
				<HeaderLink href="/category/job">Job</HeaderLink>
			</div>
		</div>
		<div id="drawer-overlay" class="drawer-overlay"></div>
	</nav>
</header>

<!-- AUTH MODAL -->
<div id="auth-modal" class="auth-modal" style="display:none;" role="dialog" aria-modal="true">
	<div class="auth-modal-overlay" id="auth-modal-overlay"></div>
	<div class="auth-modal-box">
		<button class="auth-modal-close" id="auth-modal-close" aria-label="Close">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
		</button>

		<div class="auth-tabs">
			<button class="auth-tab active" data-tab="login">Sign In</button>
			<button class="auth-tab" data-tab="register">Create Account</button>
		</div>

		<!-- LOGIN FORM -->
		<div id="tab-login" class="auth-form-section">
			<h2 class="auth-title">Welcome back</h2>
			<p class="auth-subtitle">Sign in to your TownScribe account</p>
			<div id="login-error" class="auth-error" style="display:none;"></div>
			<div id="login-success" class="auth-success" style="display:none;"></div>
			<div class="auth-field">
				<label for="login-email">Email address</label>
				<input type="email" id="login-email" placeholder="you@example.com" autocomplete="email" />
			</div>
			<div class="auth-field">
				<label for="login-password">Password</label>
				<input type="password" id="login-password" placeholder="Your password" autocomplete="current-password" />
			</div>
			<button id="login-submit" class="auth-submit-btn">
				<span id="login-btn-text">Sign In</span>
				<span id="login-spinner" class="spinner" style="display:none;"></span>
			</button>
			<p class="auth-switch">Don't have an account? <button class="auth-switch-btn" data-switch="register">Create one</button></p>
		</div>

		<!-- REGISTER FORM -->
		<div id="tab-register" class="auth-form-section" style="display:none;">
			<h2 class="auth-title">Join TownScribe</h2>
			<p class="auth-subtitle">Create your free account</p>
			<div id="register-error" class="auth-error" style="display:none;"></div>
			<div id="register-success" class="auth-success" style="display:none;"></div>
			<div class="auth-field">
				<label for="register-name">Display name</label>
				<input type="text" id="register-name" placeholder="Your name" autocomplete="name" />
			</div>
			<div class="auth-field">
				<label for="register-email">Email address</label>
				<input type="email" id="register-email" placeholder="you@example.com" autocomplete="email" />
			</div>
			<div class="auth-field">
				<label for="register-password">Password <span class="field-hint">(min. 8 characters)</span></label>
				<input type="password" id="register-password" placeholder="Choose a strong password" autocomplete="new-password" />
			</div>
			<button id="register-submit" class="auth-submit-btn">
				<span id="register-btn-text">Create Account</span>
				<span id="register-spinner" class="spinner" style="display:none;"></span>
			</button>
			<p class="auth-switch">Already have an account? <button class="auth-switch-btn" data-switch="login">Sign in</button></p>
		</div>
	</div>
</div>

<script is:inline define:vars={{ AUTH_API }}>
	const openBtn = document.getElementById('menu-toggle');
	const closeBtn = document.getElementById('menu-close');
	const drawer = document.getElementById('nav-drawer');
	const overlay = document.getElementById('drawer-overlay');

	function toggleMenu() {
		drawer?.classList.toggle('open');
		overlay?.classList.toggle('active');
		document.body.classList.toggle('menu-lock');
	}

	openBtn?.addEventListener('click', toggleMenu);
	closeBtn?.addEventListener('click', toggleMenu);
	overlay?.addEventListener('click', toggleMenu);

	const TS_TOKEN_KEY = 'ts_auth_token';
	const TS_USER_KEY  = 'ts_auth_user';

	function getToken() { return localStorage.getItem(TS_TOKEN_KEY); }
	function getUser()  { 
		try { return JSON.parse(localStorage.getItem(TS_USER_KEY) || 'null'); } 
		catch { return null; } 
	}
	function saveAuth(token, user) {
		localStorage.setItem(TS_TOKEN_KEY, token);
		localStorage.setItem(TS_USER_KEY, JSON.stringify(user));
	}
	function clearAuth() {
		localStorage.removeItem(TS_TOKEN_KEY);
		localStorage.removeItem(TS_USER_KEY);
	}

	function getInitials(name) {
		return name ? name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) : '?';
	}

	function renderLoggedIn(user) {
		const signinBtn = document.getElementById('auth-signin-btn');
		const userMenu  = document.getElementById('user-menu');
		const avatarDisp = document.getElementById('user-avatar-display');
		const dropName  = document.getElementById('dropdown-name');
		const dropEmail = document.getElementById('dropdown-email');

		if (signinBtn) signinBtn.style.display = 'none';
		if (userMenu)  userMenu.style.display  = 'flex';

		if (avatarDisp) {
			if (user.avatarUrl) {
				avatarDisp.innerHTML = `<img src="${user.avatarUrl}" alt="${user.displayName}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />`;
			} else {
				avatarDisp.textContent = getInitials(user.displayName);
			}
		}
		if (dropName)  dropName.textContent  = user.displayName;
		if (dropEmail) dropEmail.textContent = user.email;
	}

	function renderLoggedOut() {
		const signinBtn = document.getElementById('auth-signin-btn');
		const userMenu  = document.getElementById('user-menu');
		if (signinBtn) signinBtn.style.display = 'flex';
		if (userMenu)  userMenu.style.display  = 'none';
	}

	function initAuthState() {
		const user = getUser();
		const token = getToken();
		if (user && token) {
			renderLoggedIn(user);
			fetch(`${AUTH_API}/me`, { headers: { 'Authorization': `Bearer ${token}` } })
				.then(r => { if (!r.ok) { clearAuth(); renderLoggedOut(); } })
				.catch(() => {});
		} else {
			renderLoggedOut();
		}
	}

	function openModal(tab = 'login') {
		const modal = document.getElementById('auth-modal');
		if (modal) { modal.style.display = 'flex'; document.body.classList.add('menu-lock'); }
		switchTab(tab);
	}

	document.addEventListener('DOMContentLoaded', () => {
		initAuthState();
		document.getElementById('auth-signin-btn')?.addEventListener('click', () => openModal('login'));
		document.getElementById('auth-modal-close')?.addEventListener('click', () => {
			document.getElementById('auth-modal').style.display = 'none';
			document.body.classList.remove('menu-lock');
		});
	});
</script>

<style>
	header { margin: 0; padding: 0; background: #ffffff; box-shadow: 0 2px 8px rgba(0, 0, 0, 5%); position: sticky; top: 0; z-index: 100; }
	.main-navigation { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
	.brand-row { display: flex; align-items: center; justify-content: space-between; height: 75px; }
	.left-brand-group { display: flex; align-items: center; gap: 1rem; height: 100%; }
	.right-actions { display: flex; align-items: center; gap: 0.75rem; }

	/* Cleaned-up Flex Brand Container */
	.brand-logo-wrapper { 
		margin: 0; 
		padding: 0;
		display: flex; 
		align-items: center;
		height: 100%;
	}
	.brand-logo-wrapper a { 
		display: flex; 
		align-items: center; 
		gap: 0.5rem;
		text-decoration: none;
		height: 100%;
	}
	
	/* Logo Graphic Style rules */
	.site-logo-graphic {
		height: 48px;
		width: auto;
		object-fit: contain;
		display: block;
	}

	/* CSS Text Fallback Style (Hidden initially while image tries to load) */
	.site-title-text {
		display: none;
		font-size: 1.35rem;
		font-weight: 800;
		color: #111111;
		white-space: nowrap;
		letter-spacing: -0.5px;
	}

	.menu-btn { background: none; border: none; color: #000; cursor: pointer; padding: 0.5rem 0.25rem; display: flex; align-items: center; }
	.internal-links { display: flex; }
	.internal-links :global(a) { padding: 1rem 0.5rem; color: #000; text-decoration: none; border-bottom: 4px solid transparent; font-weight: 600; }
	.internal-links :global(a.active) { border-bottom-color: #14b8a6; }

	.auth-controls { display: flex; align-items: center; }
	.auth-btn { border: none; cursor: pointer; font-weight: 600; font-size: 0.875rem; border-radius: 6px; }
	.signin-btn { background: #dc2626; color: #fff; padding: 0.45rem 1rem; }

	.user-menu { position: relative; align-items: center; }
	.avatar-circle { width: 36px; height: 36px; border-radius: 50%; background: #dc2626; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
	
	.push-notify-btn { background: #dc2626; border: none; border-radius: 50%; width: 36px; height: 36px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
	
	.nav-drawer { position: fixed; top: 0; left: -320px; width: 300px; height: 100vh; background: #142129; z-index: 200; display: flex; flex-direction: column; transition: transform 0.28s ease; padding: 1.5rem; }
	.nav-drawer.open { transform: translateX(320px); }
	.drawer-header { display: flex; justify-content: space-between; align-items: center; }
	.drawer-title { color: #ffffff; font-weight: 600; }
	.drawer-links { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 2rem; }
	.drawer-links :global(a) { color: #ffffff; font-size: 1.2rem; text-decoration: none; }
	.drawer-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.4); z-index: 150; opacity: 0; pointer-events: none; transition: opacity 0.25s; }
	.drawer-overlay.active { opacity: 1; pointer-events: auto; }
	.social-links { display: flex; gap: 1.2rem; align-items: center; }

	@media (max-width: 720px) { .social-links { display: none; } }
	@media (max-width: 480px) {
		.brand-row { height: 65px; }
		.site-logo-graphic { height: 38px; }
		.site-title-text { font-size: 1.1rem; }
	}
</style>
