---
import { AUTH_API, PUSH_API, SOCIAL_LINKS } from '../consts';
import SocialIcon from './SocialIcon.astro';
import { CATEGORIES } from '../categories';
import HeaderLink from './HeaderLink.astro';
import TvIcon from './TvIcon.astro';

// Path without trailing slash, for highlighting the current section
const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
// Fallback date for the utility bar (replaced in the browser with today's date in Lagos)
const todayLabel = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' }).format(new Date());

---

<!-- ═══════════════════════════════════════════════════════════
     HEADER / NAV
════════════════════════════════════════════════════════════ -->
<!-- Utility bar: date, TownScribe TV, socials -->
<div class="util">
  <div class="wrap util-row">
    <span class="util-date" id="util-date">{todayLabel}</span>
    <nav class="util-links" aria-label="TownScribe elsewhere">
      <a class="util-tv" href="/tv"><TvIcon size={15} /> TownScribe TV</a>
      {SOCIAL_LINKS.filter((l) => l.id !== 'youtube').map((l) => (
        <a class="util-social" href={l.url} target="_blank" rel="noopener noreferrer" aria-label={`TownScribe on ${l.label}`} title={l.label}>
          <SocialIcon id={l.id} size={16} />
        </a>
      ))}
    </nav>
  </div>
</div>

<!-- Masthead: menu button, logo, account and alerts -->
<header class="mast">
  <div class="wrap mast-row">
    <div class="mast-left">
      <button id="menu-toggle" class="menu-btn" aria-label="Open menu" aria-controls="nav-drawer">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6"  x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <a class="brand" href="/" aria-label="TownScribe Media home">
        <img src="/townscribe-img.jpg" alt="" width="46" height="46" />
        <span class="brand-text">
          <span class="brand-name">TownScribe</span>
          <span class="brand-tag">Local news · Global reach</span>
        </span>
      </a>
    </div>

    <div class="right-actions">
        <!-- Auth: Sign In button OR User Avatar -->
        <div class="auth-controls">
          <button id="auth-signin-btn" class="auth-btn signin-btn" style="display:none;">Sign In</button>

          <div id="user-menu" class="user-menu" style="display:none;">
            <button id="user-avatar-btn" class="user-avatar-btn" aria-label="User menu">
              <div id="user-avatar-display" class="avatar-circle">?</div>
            </button>
            <div id="user-dropdown" class="user-dropdown" style="display:none;">
              <div class="dropdown-header">
                <span id="dropdown-name"  class="dropdown-name"></span>
                <span id="dropdown-email" class="dropdown-email"></span>
              </div>
              <hr class="dropdown-divider" />
              <a href="/bookmarks" class="dropdown-item">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                My Bookmarks
              </a>
              <a href="/profile" class="dropdown-item">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                Profile
              </a>
              <hr class="dropdown-divider" />
              <button id="signout-btn" class="dropdown-item signout-item">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                Sign Out
              </button>
            </div>
          </div>
        </div>

        <!-- Light / dark switch (remembers the reader's choice) -->
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>

        <!-- Push Notification Bell -->
        <button id="push-subscribe-btn" class="push-notify-btn" title="Get news alerts" aria-label="Subscribe to news alerts">
          🔔
        </button>
    </div>
  </div>
</header>

<!-- Section menu: one row, sticks to the top, scrolls sideways on phones -->
<nav class="secnav" aria-label="Sections">
  <div class="wrap secnav-row">
  <ul>
    <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
    {CATEGORIES.map((c) => (
      <li><a href={`/category/${c.slug}`} aria-current={currentPath.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>{c.label}</a></li>
    ))}
  </ul>
  <a class="secnav-tv" href="/tv" aria-current={currentPath.startsWith('/tv') ? 'page' : undefined}><TvIcon size={15} /> TV</a>
  </div>
</nav>

<div class="drawer-root">
  <!-- Side Drawer (full menu) -->
    <div id="nav-drawer" class="nav-drawer">
      <div class="drawer-header">
        <span class="drawer-title">Menu</span>
        <button id="menu-close" class="close-btn" aria-label="Close Menu">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6"  x2="6"  y2="18"></line>
            <line x1="6"  y1="6"  x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="drawer-links">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
        <HeaderLink href="/tv">📺 TownScribe TV</HeaderLink>
        <hr class="drawer-divider" />
        {CATEGORIES.map((c) => (
          <HeaderLink href={`/category/${c.slug}`}>{c.label}</HeaderLink>
        ))}
      </div>
      <div class="drawer-follow">
        <span class="drawer-follow-title">Follow TownScribe</span>
        <div class="drawer-follow-links">
          {SOCIAL_LINKS.map((l) => (
            <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={`TownScribe on ${l.label}`} title={l.label}>
              <SocialIcon id={l.id} size={20} />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div id="drawer-overlay" class="drawer-overlay"></div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     AUTH MODAL  (must live outside <header> in the DOM)
════════════════════════════════════════════════════════════ -->
<div id="auth-modal" class="auth-modal" style="display:none;" role="dialog" aria-modal="true" aria-label="Sign in or create account">
  <div id="auth-modal-overlay" class="auth-modal-overlay"></div>
  <div class="auth-modal-box">

    <!-- Close -->
    <button id="auth-modal-close" class="auth-modal-close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6"  y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Tabs -->
    <div class="auth-tabs">
      <button class="auth-tab active" data-tab="login">Sign In</button>
      <button class="auth-tab"        data-tab="register">Register</button>
    </div>

    <!-- LOGIN -->
    <div id="tab-login">
      <h2 class="auth-title">Welcome back</h2>
      <p class="auth-subtitle">Sign in to your TownScribe account</p>
      <div id="login-error"   class="auth-error"   style="display:none;"></div>
      <div id="login-success" class="auth-success" style="display:none;"></div>
      <div class="auth-field">
        <label for="login-email">Email</label>
        <input type="email"    id="login-email"    placeholder="you@example.com"  autocomplete="email" />
      </div>
      <div class="auth-field">
        <label for="login-password">Password</label>
        <input type="password" id="login-password" placeholder="Your password" autocomplete="current-password" />
      </div>
      <button id="login-submit" class="auth-submit-btn">
        <span id="login-btn-text">Sign In</span>
        <span id="login-spinner" class="spinner" style="display:none;"></span>
      </button>
      <p class="auth-switch">
        Don't have an account?
        <button class="auth-switch-btn" data-switch="register">Create one</button>
      </p>
    </div>

    <!-- REGISTER -->
    <div id="tab-register" style="display:none;">
      <h2 class="auth-title">Create account</h2>
      <p class="auth-subtitle">Join TownScribe to save articles and more</p>
      <div id="register-error"   class="auth-error"   style="display:none;"></div>
      <div id="register-success" class="auth-success" style="display:none;"></div>
      <div class="auth-field">
        <label for="register-name">Full Name</label>
        <input type="text"     id="register-name"     placeholder="Your name"          autocomplete="name" />
      </div>
      <div class="auth-field">
        <label for="register-email">Email</label>
        <input type="email"    id="register-email"    placeholder="you@example.com"    autocomplete="email" />
      </div>
      <div class="auth-field">
        <label for="register-password">
          Password <span class="field-hint">(min. 8 characters)</span>
        </label>
        <input type="password" id="register-password" placeholder="Create a password"  autocomplete="new-password" />
      </div>
      <button id="register-submit" class="auth-submit-btn">
        <span id="register-btn-text">Create Account</span>
        <span id="register-spinner" class="spinner" style="display:none;"></span>
      </button>
      <p class="auth-switch">
        Already have an account?
        <button class="auth-switch-btn" data-switch="login">Sign in</button>
      </p>
    </div>

  </div>
</div>


<!-- ═══════════════════════════════════════════════════════════
     SCRIPTS
════════════════════════════════════════════════════════════ -->
<script is:inline define:vars={{ AUTH_API, PUSH_API }}>

  // ── THEME SWITCH ──────────────────────────────────────────
  (function () {
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const current = () => root.getAttribute('data-theme') || (media.matches ? 'dark' : 'light');
    function label() {
      if (!btn) return;
      const next = current() === 'dark' ? 'light' : 'dark';
      btn.setAttribute('aria-label', `Switch to ${next} mode`);
      btn.title = `Switch to ${next} mode`;
      btn.dataset.mode = current();
    }
    btn?.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('ts_theme', next); } catch {}
      label();
    });
    // Follow the device when it changes, unless the reader picked a theme
    media.addEventListener?.('change', () => { if (!root.getAttribute('data-theme')) label(); });
    label();
  })();

  // ── DATE (utility bar) ────────────────────────────────────
  try {
    const dateEl = document.getElementById('util-date');
    if (dateEl) dateEl.textContent = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' }).format(new Date());
  } catch {}

  // ── DRAWER ────────────────────────────────────────────────
  const menuToggle  = document.getElementById('menu-toggle');
  const menuClose   = document.getElementById('menu-close');
  const navDrawer   = document.getElementById('nav-drawer');
  const drawerOverlay = document.getElementById('drawer-overlay');

  function toggleMenu() {
    const open = navDrawer?.classList.toggle('open');
    menuToggle?.setAttribute('aria-expanded', String(!!open));
    drawerOverlay?.classList.toggle('active');
    document.body.classList.toggle('menu-lock');
  }
  menuToggle?.addEventListener('click', toggleMenu);
  menuClose?.addEventListener('click', toggleMenu);
  drawerOverlay?.addEventListener('click', toggleMenu);


  // ── AUTH HELPERS ──────────────────────────────────────────
  const TS_TOKEN_KEY = 'ts_auth_token';
  const TS_USER_KEY  = 'ts_auth_user';

  function getToken() { return localStorage.getItem(TS_TOKEN_KEY); }
  function getUser()  {
    try { return JSON.parse(localStorage.getItem(TS_USER_KEY) || 'null'); }
    catch { return null; }
  }
  function saveAuth(token, user) {
    localStorage.setItem(TS_TOKEN_KEY, token);
    localStorage.setItem(TS_USER_KEY, JSON.stringify(user));
  }
  function clearAuth() {
    localStorage.removeItem(TS_TOKEN_KEY);
    localStorage.removeItem(TS_USER_KEY);
  }
  function getInitials(name) {
    return name ? name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) : '?';
  }


  // ── AUTH UI ───────────────────────────────────────────────
  function renderLoggedIn(user) {
    const signinBtn  = document.getElementById('auth-signin-btn');
    const userMenu   = document.getElementById('user-menu');
    const avatarDisp = document.getElementById('user-avatar-display');
    const dropName   = document.getElementById('dropdown-name');
    const dropEmail  = document.getElementById('dropdown-email');

    if (signinBtn)  signinBtn.style.display  = 'none';
    if (userMenu)   userMenu.style.display   = 'flex';
    if (avatarDisp) {
      if (user.avatarUrl) {
        avatarDisp.innerHTML = `<img src="${user.avatarUrl}" alt="${user.displayName}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">`;
      } else {
        avatarDisp.textContent = getInitials(user.displayName);
      }
    }
    if (dropName)  dropName.textContent  = user.displayName || '';
    if (dropEmail) dropEmail.textContent = user.email || '';
  }

  function renderLoggedOut() {
    const signinBtn = document.getElementById('auth-signin-btn');
    const userMenu  = document.getElementById('user-menu');
    if (signinBtn) signinBtn.style.display = 'flex';
    if (userMenu)  userMenu.style.display  = 'none';
  }

  function initAuthState() {
    const user  = getUser();
    const token = getToken();
    if (user && token) {
      renderLoggedIn(user);
      // Silently validate token in background
      fetch(`${AUTH_API}/me`, { headers: { Authorization: `Bearer ${token}` } })
        .then(r => { if (!r.ok) { clearAuth(); renderLoggedOut(); } })
        .catch(() => {});
    } else {
      renderLoggedOut();
    }
  }


  // ── MODAL ─────────────────────────────────────────────────
  function openModal(tab = 'login') {
    const modal = document.getElementById('auth-modal');
    if (modal) { modal.style.display = 'flex'; document.body.classList.add('menu-lock'); }
    switchTab(tab);
  }
  function closeModal() {
    const modal = document.getElementById('auth-modal');
    if (modal) { modal.style.display = 'none'; document.body.classList.remove('menu-lock'); }
  }
  function switchTab(tab) {
    document.querySelectorAll('.auth-tab').forEach(t =>
      t.classList.toggle('active', t.dataset.tab === tab)
    );
    document.getElementById('tab-login').style.display     = tab === 'login'    ? 'block' : 'none';
    document.getElementById('tab-register').style.display = tab === 'register' ? 'block' : 'none';
  }

  function showMsg(id, msg, type) {
    const el = document.getElementById(id);
    if (el) { el.textContent = msg; el.style.display = 'block'; }
  }
  function hideMsg(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  }
  function setLoading(btnId, spinnerId, loading) {
    const btn = document.getElementById(btnId);
    const sp  = document.getElementById(spinnerId);
    if (btn) btn.style.display = loading ? 'none'         : 'inline';
    if (sp)  sp.style.display  = loading ? 'inline-block' : 'none';
  }


  // ── LOGIN ─────────────────────────────────────────────────
  async function handleLogin() {
    const email    = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value;
    hideMsg('login-error');
    if (!email || !password) return showMsg('login-error', 'Please fill in all fields.');
    setLoading('login-btn-text', 'login-spinner', true);
    try {
      const res  = await fetch(`${AUTH_API}/login`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email, password }),
      });
      const data = await res.json();
      if (!res.ok) {
        showMsg('login-error', data.error || 'Login failed. Please try again.');
      } else {
        saveAuth(data.token, data.user);
        renderLoggedIn(data.user);
        closeModal();
      }
    } catch {
      showMsg('login-error', 'Network error. Please try again.');
    } finally {
      setLoading('login-btn-text', 'login-spinner', false);
    }
  }


  // ── REGISTER ──────────────────────────────────────────────
  async function handleRegister() {
    const displayName = document.getElementById('register-name').value.trim();
    const email       = document.getElementById('register-email').value.trim();
    const password    = document.getElementById('register-password').value;
    hideMsg('register-error');
    if (!displayName || !email || !password)
      return showMsg('register-error', 'Please fill in all fields.');
    if (password.length < 8)
      return showMsg('register-error', 'Password must be at least 8 characters.');
    setLoading('register-btn-text', 'register-spinner', true);
    try {
      const res  = await fetch(`${AUTH_API}/register`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email, password, displayName }),
      });
      const data = await res.json();
      if (!res.ok) {
        showMsg('register-error', data.error || 'Registration failed. Please try again.');
      } else {
        showMsg('register-success', '✅ Account created! Check your email to verify before signing in.');
        document.getElementById('register-name').value     = '';
        document.getElementById('register-email').value    = '';
        document.getElementById('register-password').value = '';
      }
    } catch {
      showMsg('register-error', 'Network error. Please try again.');
    } finally {
      setLoading('register-btn-text', 'register-spinner', false);
    }
  }


  // ── SIGN OUT ──────────────────────────────────────────────
  async function handleSignOut() {
    const token = getToken();
    if (token) {
      fetch(`${AUTH_API}/logout`, {
        method:  'POST',
        headers: { Authorization: `Bearer ${token}` },
      }).catch(() => {});
    }
    clearAuth();
    renderLoggedOut();
    const dd = document.getElementById('user-dropdown');
    if (dd) dd.style.display = 'none';
    window.location.href = '/';
  }


  // ── NEWS ALERTS (web push) ────────────────────────────────
  // One code path for everyone (signed in or not):
  //  - the signing key always comes from the push worker that sends alerts,
  //  - subscriptions are saved to that worker (and copied to the account API),
  //  - browsers subscribed with an old/wrong key are re-subscribed quietly.
  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64  = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = atob(base64);
    return Uint8Array.from([...rawData].map(c => c.charCodeAt(0)));
  }

  let pushKeyPromise;
  function getPushKey() {
    pushKeyPromise ??= fetch(`${PUSH_API}/vapid-public-key`).then(r => r.json()).then(d => d.key);
    return pushKeyPromise;
  }

  function usesKey(subscription, key) {
    const current = subscription.options && subscription.options.applicationServerKey;
    if (!current) return false;
    const a = new Uint8Array(current);
    const b = urlBase64ToUint8Array(key);
    return a.length === b.length && a.every((v, i) => v === b[i]);
  }

  async function saveSubscription(subscription) {
    const body = JSON.stringify(subscription);
    const res = await fetch(`${PUSH_API}/subscribe`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
    if (!res.ok) throw new Error(`push worker replied ${res.status}`);
    // Keep the account service in step too (best effort)
    fetch(`${AUTH_API}/push/subscribe`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body }).catch(() => {});
    try { localStorage.setItem('ts_push_synced', String(Date.now())); } catch {}
  }

  async function subscribeWithServerKey(reg) {
    const key = await getPushKey();
    const subscription = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(key) });
    await saveSubscription(subscription);
    return subscription;
  }

  async function initNewsAlerts() {
    const btn = document.getElementById('push-subscribe-btn');
    if (!btn) return;

    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
      btn.style.display = 'none';
      return;
    }

    let reg;
    try {
      await navigator.serviceWorker.register('/sw.js');
      reg = await navigator.serviceWorker.ready;
    } catch (err) {
      console.error('[Alerts] Service worker registration failed:', err);
      btn.style.display = 'none';
      return;
    }

    function showState(on) {
      btn.classList.toggle('subscribed', on);
      if (Notification.permission === 'denied') {
        btn.title = 'News alerts are blocked in your browser settings';
      } else {
        btn.title = on ? 'News alerts are ON (click to turn off)' : 'Get news alerts';
      }
      btn.setAttribute('aria-label', on ? 'Turn off news alerts' : 'Turn on news alerts');
    }

    // Repair: re-subscribe readers stuck on the wrong key, and make sure the
    // push worker has every existing subscription (re-sent at most weekly).
    let existing = await reg.pushManager.getSubscription();
    if (existing && Notification.permission === 'granted') {
      try {
        const key = await getPushKey();
        if (!usesKey(existing, key)) {
          await existing.unsubscribe();
          existing = await subscribeWithServerKey(reg);
        } else {
          let last = 0;
          try { last = Number(localStorage.getItem('ts_push_synced')) || 0; } catch {}
          if (Date.now() - last > 7 * 24 * 3600 * 1000) await saveSubscription(existing);
        }
      } catch (err) {
        console.error('[Alerts] Could not refresh subscription:', err);
      }
    }
    showState(!!existing);

    btn.addEventListener('click', async () => {
      const current = await reg.pushManager.getSubscription();
      if (current) {
        if (!confirm('Turn off TownScribe news alerts on this device?')) return;
        try {
          await current.unsubscribe();
          const body = JSON.stringify({ endpoint: current.endpoint });
          fetch(`${PUSH_API}/unsubscribe`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body }).catch(() => {});
          fetch(`${AUTH_API}/push/unsubscribe`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body }).catch(() => {});
        } catch (err) {
          console.error('[Alerts] Unsubscribe failed:', err);
        }
        showState(false);
        return;
      }

      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        alert('News alerts are blocked. Allow notifications for this site in your browser settings, then tap the bell again.');
        showState(false);
        return;
      }
      try {
        btn.disabled = true;
        await subscribeWithServerKey(reg);
        showState(true);
        alert('You will now get TownScribe news alerts on this device.');
      } catch (err) {
        console.error('[Alerts] Subscribe failed:', err);
        alert('Could not turn on news alerts. Please check your connection and try again.');
        showState(false);
      } finally {
        btn.disabled = false;
      }
    });
  }


  // ── BOOT ──────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {

    initAuthState();
    initNewsAlerts();

    // Modal open/close
    document.getElementById('auth-signin-btn')?.addEventListener('click', () => openModal('login'));
    document.getElementById('auth-modal-close')?.addEventListener('click', closeModal);
    document.getElementById('auth-modal-overlay')?.addEventListener('click', closeModal);

    // Tab switching
    document.querySelectorAll('.auth-tab').forEach(tab =>
      tab.addEventListener('click', () => switchTab(tab.dataset.tab))
    );
    document.querySelectorAll('.auth-switch-btn').forEach(btn =>
      btn.addEventListener('click', () => switchTab(btn.dataset.switch))
    );

    // Form submit
    document.getElementById('login-submit')?.addEventListener('click', handleLogin);
    document.getElementById('register-submit')?.addEventListener('click', handleRegister);
    document.getElementById('login-password')?.addEventListener('keydown',    e => { if (e.key === 'Enter') handleLogin(); });
    document.getElementById('register-password')?.addEventListener('keydown', e => { if (e.key === 'Enter') handleRegister(); });

    // User dropdown toggle
    document.getElementById('user-avatar-btn')?.addEventListener('click', e => {
      e.stopPropagation();
      const dd = document.getElementById('user-dropdown');
      if (dd) dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
    });
    // Close dropdown on outside click
    document.addEventListener('click', () => {
      const dd = document.getElementById('user-dropdown');
      if (dd) dd.style.display = 'none';
    });

    document.getElementById('signout-btn')?.addEventListener('click', handleSignOut);

    // Auto-open login after email verification
    if (window.location.search.includes('verified=1')) {
      openModal('login');
      showMsg('login-success', '✅ Email verified! You can now sign in.');
      window.history.replaceState({}, '', window.location.pathname);
    }
  });


  // ── GLOBAL AUTH API (accessible site-wide) ────────────────
  window.TSAuth = {
    getToken,
    getUser,
    isLoggedIn: () => !!(getToken() && getUser()),
    AUTH_API,
  };

</script>


