---
// Paginated article listing (/blog and /category/*).
import BaseLayout from './BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import PostGrid from '../components/PostGrid.astro';
import type { Post } from '../posts';

interface Props {
	title: string;
	description: string;
	heading: string;
	subtitle?: string;
	posts: Post[];
	base: string;
	current: number;
	total: number;
	showCategory?: boolean;
}

const { title, description, heading, subtitle, posts, base, current, total, showCategory = true } = Astro.props;
---

<BaseLayout title={current > 1 ? `${title} — Page ${current}` : title} description={description}>
	<div class="wrap listing">
		<header class="listing-header">
			<p class="breadcrumbs"><a href="/">Home</a> / {heading}</p>
			<h1>{heading}</h1>
			{subtitle && <p class="subtitle">{subtitle}</p>}
		</header>

		{posts.length === 0 ? (
			<p class="empty">No articles published here yet. Where Every Story Breathes...</p>
		) : (
			<PostGrid posts={posts} showCategory={showCategory} eager={4} />
		)}

		<Pagination base={base} current={current} total={total} />
	</div>
</BaseLayout>

<style>
	.listing {
		padding-block: 1.5rem 1rem;
	}
	.listing-header {
		border-bottom: 3px solid var(--brand);
		padding-bottom: 1rem;
		margin-bottom: 1.75rem;
	}
	.listing-header h1 {
		font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem);
		margin: 0.35rem 0;
	}
	.breadcrumbs,
	.subtitle {
		color: var(--muted);
		margin: 0;
		font-size: 0.9rem;
	}
	.breadcrumbs a {
		color: var(--muted);
	}
	.breadcrumbs a:hover {
		color: var(--red);
	}
	.subtitle {
		font: 400 1.05rem/1.5 var(--font-read);
		color: var(--ink-2);
	}
	.empty {
		color: var(--ink-2);
	}
</style>
