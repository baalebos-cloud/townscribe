---
// Layout for standalone pages (About, Contact, legal pages, account pages).
// Unlike BlogPost it has no comments, view counter, ads or related news.
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	/** Optional visible <h1>; leave out when the page body has its own heading */
	heading?: string;
	heroImage?: string;
	noindex?: boolean;
	ads?: boolean;
}

const {
	title,
	description = 'TownScribe Media — where every story breathes.',
	heading,
	heroImage,
	noindex = false,
	ads = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} noindex={noindex} ads={ads}>
	<slot name="head" slot="head" />
	<div class="wrap"><div class="page">
		{heroImage && <img class="page-hero" src={heroImage} alt="" width="1020" height="510" />}
		{heading && <h1 class="page-heading">{heading}</h1>}
		<slot />
	</div></div>
</BaseLayout>

<style>
	.page {
		max-width: 760px;
		margin: 0 auto;
		padding-block: 2rem 1rem;
		font: 400 1.08rem/1.7 var(--font-read);
		color: var(--ink);
	}
	.page :global(h1),
	.page :global(h2),
	.page :global(h3) {
		font-family: var(--font-head);
	}
	.page-hero {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
		margin-bottom: 1.5rem;
	}
	.page-heading {
		text-align: center;
		margin: 0.5rem 0 1.5rem;
	}
</style>
