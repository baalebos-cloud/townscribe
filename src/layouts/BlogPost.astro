---
import Analytics from '@vercel/analytics/astro';
import SEO from '../components/SEO.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import InArticleAd from '../components/InArticleAd.astro';

type Props = CollectionEntry<'blog'>['data'];

const { 
    title, 
    description, 
    pubDate, 
    updatedDate, 
    heroImage, 
    author, 
    category, 
    seoTitle, 
    seoDescription,
    youtubeUrl
} = Astro.props;

const finalTitle = seoTitle || `${title} | TownScribe`;
const finalDescription = seoDescription || description;

const canonicalURL = new URL(Astro.url.pathname, 'https://news.townscribe.org');

const currentSlug = Astro.params.slug;
const pageId = `/blog/${currentSlug}`;

const allPosts = (await getCollection('blog')).sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
        new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const currentPostIndex = allPosts.findIndex((post: CollectionEntry<'blog'>) => post.id === currentSlug);
const nextPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const prevPost = currentPostIndex < allPosts.length - 1 ? allPosts[currentPostIndex + 1] : null;

const relatedPosts = allPosts
    .filter((post: CollectionEntry<'blog'>) => post.id !== currentSlug)
    .slice(0, 5);

function getYouTubeId(url: string | undefined) {
    if (!url) return null;
    const cleanUrl = url.trim();
    if (cleanUrl.includes('watch')) {
        const searchParams = new URL(cleanUrl).searchParams;
        return searchParams.get('v');
    }
    if (cleanUrl.includes('youtu.be/')) {
        return cleanUrl.split('youtu.be/')[1]?.split(/[?#]/)[0];
    }
    if (cleanUrl.includes('/embed/') || cleanUrl.includes('/shorts/') || cleanUrl.includes('/live/')) {
        return cleanUrl.split('/').pop()?.split(/[?#]/)[0];
    }
    if (cleanUrl.length === 11) return cleanUrl;
    return null;
}

const extractedVideoId = getYouTubeId(youtubeUrl);
const fallbackRedirectUrl = "https://youtube.com/@townscribetv?si=ADdKzVgGQxb9gBmF";
const finalRedirectTarget = youtubeUrl ? youtubeUrl.trim() : fallbackRedirectUrl;

const AUTH_API = 'https://townscribe-auth.jayeolaoluwadamilare.workers.dev';
---

<html lang="en">
    <head>
        <title>{finalTitle}</title>
        <meta name="description" content={finalDescription} />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={finalTitle} />
        <meta property="og:description" content={finalDescription} />
        <meta property="og:image" content={new URL(heroImage || '/townscribe-img.jpg', 'https://news.townscribe.org')} />
        {pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
        {updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
        <meta property="article:author" content={author || "TownScribe Staff"} />
        <meta property="article:section" content={category || "World"} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={finalTitle} />
        <meta property="twitter:description" content={finalDescription} />
        <meta property="twitter:image" content={new URL(heroImage || '/townscribe-img.jpg', 'https://news.townscribe.org')} />

        <BaseHead title={finalTitle} description={finalDescription} />
        <SEO title={finalTitle} description={finalDescription} image={heroImage || '/townscribe-img.jpg'} type="article" />
        <Analytics />

        <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d503922d74b2443ca33ae2ba8bd66afc"}'></script>

        <style>
            main { width: calc(100% - 2em); max-width: 100%; margin: 0; }
            .hero-image { width: 100%; }
            .hero-image img { display: block; margin: 0 auto; border-radius: 12px; box-shadow: var(--box-shadow); }
            .prose { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 1em; color: rgb(var(--gray-dark)); }
            .title { margin-bottom: 1em; padding: 1em 0; text-align: center; line-height: 1; }
            .title h1 { margin: 0 0 0.5em 0; }
            .date { margin-bottom: 0.5em; color: rgb(var(--gray)); }
            .last-updated-on { font-style: italic; }
            .meta-attribution { font-size: 0.9rem; color: rgb(var(--gray)); margin-top: 0.5em; text-transform: capitalize; }
            .view-panel { font-size: 0.9rem; color: rgb(var(--gray)); margin-top: 0.5rem; font-weight: 500; text-align: center; display: flex; align-items: center; justify-content: center; gap: 1rem; }

            /* BOOKMARK BUTTON */
            .bookmark-btn { display: inline-flex; align-items: center; gap: 0.4rem; background: none; border: 1.5px solid #e5e7eb; border-radius: 20px; padding: 0.3rem 0.85rem; font-size: 0.85rem; font-weight: 600; color: #6b7280; cursor: pointer; transition: all 0.2s ease; font-family: system-ui, sans-serif; }
            .bookmark-btn:hover { border-color: #dc2626; color: #dc2626; }
            .bookmark-btn.bookmarked { background: #dc2626; border-color: #dc2626; color: #fff; }
            .bookmark-btn.bookmarked:hover { background: #b91c1c; border-color: #b91c1c; }
            .bookmark-toast { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%) translateY(80px); background: #111; color: #fff; padding: 0.65rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; z-index: 9999; transition: transform 0.3s ease; white-space: nowrap; font-family: system-ui, sans-serif; }
            .bookmark-toast.show { transform: translateX(-50%) translateY(0); }

            .video-wrapper-zone { margin: 2rem 0; }
            .video-container { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.15); }
            .video-container iframe, #player { width: 100%; height: 100%; border: none; }
            .redirect-alert { position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); background: rgba(224, 12, 12, 0.98); color: #fff; padding: 0.6rem 1.4rem; border-radius: 30px; font-size: 0.9rem; font-weight: 600; z-index: 10; box-shadow: 0 4px 15px rgba(0,0,0,0.4); white-space: nowrap; font-family: system-ui, sans-serif; }

            .nav-pagination { display: flex; justify-content: space-between; border-top: 1px solid #edf2f7; border-bottom: 1px solid #edf2f7; padding: 1.5rem 0; margin: 2.5rem 0; font-family: system-ui, -apple-system, sans-serif; }
            .nav-block { max-width: 47%; text-decoration: none; color: #1a202c; display: flex; flex-direction: column; }
            .nav-block.next { text-align: right; margin-left: auto; }
            .nav-label { font-size: 0.75rem; text-transform: uppercase; color: #a0aec0; font-weight: 600; margin-bottom: 0.35rem; letter-spacing: 0.025em; }
            .nav-title { font-weight: 700; font-size: 0.95rem; line-height: 1.35; color: #2d3748; }
            .nav-block:hover .nav-title { color: #dc2626; }

            .related-section { margin: 3.5rem 0 2.5rem 0; font-family: system-ui, -apple-system, sans-serif; }
            .related-header-bar { background-color: #dc2626; color: white; display: inline-block; padding: 0.4rem 1.2rem; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
            .related-divider { border-top: 2px solid #dc2626; margin-top: -2px; margin-bottom: 0.5rem; }
            .related-card { display: flex; gap: 1.25rem; padding: 1.1rem 0; border-bottom: 1px solid #f1f5f9; text-decoration: none; color: inherit; align-items: center; }
            .related-card:hover .card-title { color: #dc2626; }
            .image-container { position: relative; width: 130px; height: 85px; flex-shrink: 0; background-color: #e2e8f0; border-radius: 4px; overflow: hidden; }
            .image-container img { width: 100%; height: 100%; object-fit: cover; }
            .category-badge { position: absolute; bottom: 0; left: 0; background: rgba(17, 24, 39, 0.9); color: #fff; font-size: 0.65rem; font-weight: 600; padding: 0.15rem 0.45rem; text-transform: uppercase; letter-spacing: 0.025em; }
            .card-info { flex: 1; display: flex; flex-direction: column; gap: 0.35rem; }
            .card-title { font-size: 1rem; font-weight: 700; margin: 0; line-height: 1.35; color: #1e293b; }
            .card-date { font-size: 0.75rem; color: #64748b; font-weight: 500; }

            .article-interactions { margin-top: 3em; border-top: 1px solid rgba(var(--gray), 0.2); padding-top: 2em; }
            .reaction-section { text-align: center; margin-bottom: 2.5em; }
            .reaction-section h4 { margin-bottom: 0.75em; font-size: 1.1rem; color: rgb(var(--gray-dark)); }
            .reactions-wrapper { display: flex; justify-content: center; gap: 1rem; }
            .reaction-btn { background: #f8f9fa; border: 1px solid #ddd; border-radius: 25px; padding: 0.5rem 1.2rem; font-size: 1.2rem; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.4rem; }
            .reaction-btn:hover { transform: translateY(-2px); background: #fff; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
            .reaction-btn.active { background: #000; border-color: #000; color: #fff; }
            .reaction-btn span { font-size: 0.9rem; font-weight: bold; }
            .anonymous-feedback-box { padding: 2em; background-color: #f8f9fa; border-radius: 12px; border: 1px solid rgba(var(--gray), 0.15); margin-top: 2rem; }
            .anonymous-feedback-box h3 { margin-top: 0; margin-bottom: 0.5em; font-size: 1.4rem; color: #111; }
            .anonymous-feedback-box p { font-size: 0.95rem; color: #444; margin-bottom: 1.5em; }
            #remark42 { margin-top: 2rem; min-height: 300px; width: 100%; }
        </style>
    </head>

    <body>
        <Header />
        <main>
            <article>
                <div class="hero-image">
                    {heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
                </div>
                <div class="prose">
                    <div class="title">
                        <div class="date">
                            <FormattedDate date={pubDate} />
                            {updatedDate && <div class="last-updated-on">Last updated on <FormattedDate date={updatedDate} /></div>}
                        </div>
                        <h1>{title}</h1>
                        <div class="meta-attribution">
                            By <strong>{author || "TownScribe Staff"}</strong> in <span>{category || "World"}</span>
                        </div>
                        <div class="view-panel">
                            <span>👁️ <span id="view-count-number">loading views...</span></span>
                            <button id="bookmark-btn" class="bookmark-btn" title="Save article">
                                <svg id="bookmark-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <span id="bookmark-label">Save</span>
                            </button>
                        </div>
                        <hr />
                    </div>
                    
                    {youtubeUrl && (
                        <div class="video-wrapper-zone">
                            <div class="video-container">
                                <div id="player"></div>
                                <div id="redirect-timer" class="redirect-alert" style="display: none;">
                                    Preview ending. Redirecting to full video in <span id="countdown-secs">5</span>s...
                                </div>
                            </div>
                        </div>
                    )}

                    <slot />

                    <!-- INJECTED IN-ARTICLE AD UNIT -->
                    <InArticleAd />

                    <div class="nav-pagination">
                        {prevPost ? (
                            <a href={`/blog/${prevPost.id}/`} class="nav-block prev">
                                <span class="nav-label">Previous article</span>
                                <div class="nav-title">{prevPost.data.title}</div>
                            </a>
                        ) : (
                            <div class="nav-block"></div>
                        )}
                        {nextPost ? (
                            <a href={`/blog/${nextPost.id}/`} class="nav-block next">
                                <span class="nav-label">Next article</span>
                                <div class="nav-title">{nextPost.data.title}</div>
                            </a>
                        ) : (
                            <div class="nav-block"></div>
                        )}
                    </div>

                    <section class="related-section">
                        <div class="related-header-bar">Related News</div>
                        <div class="related-divider"></div>
                        {relatedPosts.map((post: CollectionEntry<'blog'>) => (
                            <a href={`/blog/${post.id}/`} class="related-card">
                                <div class="image-container">
                                    <img src={post.data.heroImage || '/townscribe-img.jpg'} alt="" loading="lazy" />
                                    <span class="category-badge">{post.data.category || 'World'}</span>
                                </div>
                                <div class="card-info">
                                    <h3 class="card-title">{post.data.title}</h3>
                                    <span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
                                </div>
                            </a>
                        ))}
                    </section>
                    
                    <div class="article-interactions">
                        <div class="reaction-section">
                            <h4>How do you feel about this news?</h4>
                            <div class="reactions-wrapper">
                                <button class="reaction-btn" data-reaction="like">👍 <span>0</span></button>
                                <button class="reaction-btn" data-reaction="love">❤️ <span>0</span></button>
                                <button class="reaction-btn" data-reaction="insightful">💡 <span>0</span></button>
                                <button class="reaction-btn" data-reaction="fire">🔥 <span>0</span></button>
                            </div>
                        </div>
                        <div class="anonymous-feedback-box">
                            <h3>Community Additions</h3>
                            <p>Have a news tip, correction, or extra context about this story? Post it below instantly. All submissions appear live on this screen immediately.</p>
                            <div id="remark42"></div>
                        </div>
                    </div>
                </div>
            </article>
        </main>

        <div id="bookmark-toast" class="bookmark-toast"></div>
        <Footer />

        <!-- BOOKMARK ENGINE -->
        <script is:inline define:vars={{ 
            AUTH_API,
            currentSlug,
            title,
            heroImage: heroImage || '/townscribe-img.jpg',
            category: category || 'World'
        }}>
            const bookmarkBtn   = document.getElementById('bookmark-btn');
            const bookmarkLabel = document.getElementById('bookmark-label');
            const bookmarkIcon  = document.getElementById('bookmark-icon');
            const bookmarkToast = document.getElementById('bookmark-toast');
            let isBookmarked = false;

            function showToast(msg) {
                bookmarkToast.textContent = msg;
                bookmarkToast.classList.add('show');
                setTimeout(() => bookmarkToast.classList.remove('show'), 2500);
            }

            function setBookmarked(state) {
                isBookmarked = state;
                bookmarkBtn.classList.toggle('bookmarked', state);
                bookmarkLabel.textContent = state ? 'Saved' : 'Save';
                bookmarkIcon.setAttribute('fill', state ? 'currentColor' : 'none');
            }

            async function initBookmark() {
                if (!window.TSAuth || !window.TSAuth.isLoggedIn()) return;
                const token = window.TSAuth.getToken();
                try {
                    const res = await fetch(`${AUTH_API}/bookmarks`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (!res.ok) return;
                    const { bookmarks } = await res.json();
                    setBookmarked(bookmarks.some(b => b.article_slug === currentSlug));
                } catch {}
            }

            async function toggleBookmark() {
                if (!window.TSAuth || !window.TSAuth.isLoggedIn()) {
                    document.getElementById('auth-signin-btn')?.click();
                    showToast('Sign in to save articles');
                    return;
                }
                const token = window.TSAuth.getToken();
                if (isBookmarked) {
                    try {
                        await fetch(`${AUTH_API}/bookmarks?slug=${encodeURIComponent(currentSlug)}`, {
                            method: 'DELETE',
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        setBookmarked(false);
                        showToast('Removed from bookmarks');
                    } catch { showToast('Failed to remove bookmark'); }
                } else {
                    try {
                        const res = await fetch(`${AUTH_API}/bookmarks`, {
                            method: 'POST',
                            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                            body: JSON.stringify({ slug: currentSlug, title, image: heroImage, category })
                        });
                        if (res.ok) { setBookmarked(true); showToast('✅ Article saved to bookmarks'); }
                        else showToast('Failed to save bookmark');
                    } catch { showToast('Failed to save bookmark'); }
                }
            }

            function trackReadingHistory() {
                try {
                    const history = JSON.parse(localStorage.getItem('ts_reading_history') || '[]');
                    const entry = { slug: currentSlug, title, category, image: heroImage, readAt: Date.now() };
                    const filtered = history.filter(h => h.slug !== currentSlug);
                    filtered.unshift(entry);
                    localStorage.setItem('ts_reading_history', JSON.stringify(filtered.slice(0, 50)));
                } catch {}
            }

            bookmarkBtn?.addEventListener('click', toggleBookmark);

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => { initBookmark(); trackReadingHistory(); });
            } else {
                initBookmark();
                trackReadingHistory();
            }
        </script>

        <!-- REMARK42 -->
        <script is:inline define:vars={{ pageId, title }}>
            window.remark_config = {
                host: 'https://comments.townscribe.org',
                site_id: 'remark',
                url: 'https://news.townscribe.org' + window.location.pathname.replace(/\/$/, ""),
                id: pageId,
                title: title,
                locale: 'en',
                max_ans: 5,
                show_anonymous: true
            };
            function loadRemark42() {
                if (document.getElementById('remark42-script')) return;
                var d = document, s = d.createElement('script');
                s.id = 'remark42-script';
                s.src = window.remark_config.host + '/web/embed.js';
                s.defer = true;
                (d.head || d.body).appendChild(s);
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadRemark42);
            } else {
                loadRemark42();
            }
        </script>

        <!-- YOUTUBE TIMELINE ENGINE -->
        {youtubeUrl && (
            <script is:inline src="https://www.youtube.com/iframe_api"></script>
            <script is:inline define:vars={{ extractedVideoId, finalRedirectTarget }}>
                let player;
                let pollInterval = null;
                const cutoffTime = 48;
                window.onYouTubeIframeAPIReady = function() {
                    if (!extractedVideoId) return;
                    player = new YT.Player('player', {
                        videoId: extractedVideoId,
                        playerVars: { 'playsinline': 1, 'rel': 0, 'modestbranding': 1, 'controls': 1 },
                        events: {
                            'onReady': (e) => { e.target.cueVideoById({ videoId: extractedVideoId, startSeconds: 0, endSeconds: cutoffTime }); },
                            'onStateChange': onPlayerStateChange
                        }
                    });
                }
                function onPlayerStateChange(event) {
                    if (event.data === YT.PlayerState.PLAYING) {
                        if (!pollInterval) pollInterval = setInterval(monitorTimeline, 250);
                    } else if (event.data === YT.PlayerState.ENDED) {
                        executeChannelRedirect();
                    } else { clearInterval(pollInterval); pollInterval = null; }
                }
                function monitorTimeline() {
                    if (!player || typeof player.getCurrentTime !== 'function') return;
                    const progress = player.getCurrentTime();
                    if (progress >= 43 && progress < cutoffTime) {
                        const alertBox = document.getElementById('redirect-timer');
                        const timeSpan = document.getElementById('countdown-secs');
                        if (alertBox && timeSpan) {
                            alertBox.style.display = 'block';
                            timeSpan.textContent = Math.ceil(cutoffTime - progress);
                        }
                    }
                }
                function executeChannelRedirect() {
                    clearInterval(pollInterval);
                    window.location.href = finalRedirectTarget;
                }
            </script>
        )}

        <!-- VIEW COUNTER -->
        <script is:inline define:vars={{ pageId }}>
            const workerUrl = "https://townscribe-view-counter.jayeolaoluwadamilare.workers.dev";
            fetch(`${workerUrl}?slug=${window.location.pathname}`, { method: "POST" })
                .then(res => res.json())
                .then(data => {
                    const display = document.getElementById("view-count-number");
                    if (display) display.textContent = `${data.views.toLocaleString()} views`;
                })
                .catch(() => {
                    const display = document.getElementById("view-count-number");
                    if (display) display.textContent = "— views";
                });
        </script>

        <!-- REACTION ENGINE -->
        <script>
            const articlePath = window.location.pathname;
            const storageKey = `townscribe_react_${articlePath}`;
            const buttons = document.querySelectorAll('.reaction-btn');
            buttons.forEach(btn => {
                const type = btn.getAttribute('data-reaction');
                const countSpan = btn.querySelector('span');
                let seedCount = Math.abs(articlePath.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) % 24) + 3;
                if (type === 'love') seedCount = Math.floor(seedCount * 0.7);
                if (type === 'insightful') seedCount = Math.floor(seedCount * 0.4);
                if (type === 'fire') seedCount = Math.floor(seedCount * 0.5);
                const savedSelection = localStorage.getItem(storageKey);
                if (savedSelection === type) { btn.classList.add('active'); seedCount += 1; }
                if (countSpan) countSpan.textContent = seedCount.toString();
                btn.addEventListener('click', () => {
                    const currentActive = localStorage.getItem(storageKey);
                    if (currentActive === type) {
                        localStorage.removeItem(storageKey);
                        btn.classList.remove('active');
                        if (countSpan) countSpan.textContent = (seedCount).toString();
                    } else {
                        buttons.forEach(b => b.classList.remove('active'));
                        localStorage.setItem(storageKey, type || '');
                        btn.classList.add('active');
                        buttons.forEach(b => {
                            const t = b.getAttribute('data-reaction');
                            const s = b.querySelector('span');
                            let base = Math.abs(articlePath.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) % 24) + 3;
                            if (t === 'love') base = Math.floor(base * 0.7);
                            if (t === 'insightful') base = Math.floor(base * 0.4);
                            if (t === 'fire') base = Math.floor(base * 0.5);
                            if (t === type) base += 1;
                            if (s) s.textContent = base.toString();
                        });
                    }
                });
            });
        </script>
    </body>
</html>
