---
import SEO from '../components/SEO.astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

// 1. Get the data Decap CMS injected into the Markdown frontmatter
const { 
	title, 
	description, 
	pubDate, 
	updatedDate, 
	heroImage, 
	author, 
	category, 
	seoTitle, 
	seoDescription 
} = Astro.props;

// 2. Fallbacks: If your writer leaves SEO blank, use the standard Title/Description
const finalTitle = seoTitle || `${title} | TownScribe`;
const finalDescription = seoDescription || description;

// 3. Automated Canonical URL generation to prevent duplicate content flags
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
	<head>
		{/* Standard Layout SEO & Core Variables */}
		<title>{finalTitle}</title>
		<meta name="description" content={finalDescription} />
		<link rel="canonical" href={canonicalURL} />

		{/* Open Graph / Facebook (Crucial for Instant Social Shares) */}
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={finalTitle} />
		<meta property="og:description" content={finalDescription} />
		<meta property="og:image" content={new URL(heroImage || '/townscribe-img.jpg', Astro.site)} />
		{pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
		{updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
		<meta property="article:author" content={author || "TownScribe Staff"} />
		<meta property="article:section" content={category || "World"} />

		{/* Twitter / X Meta Cards */}
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={finalTitle} />
		<meta property="twitter:description" content={finalDescription} />
		<meta property="twitter:image" content={new URL(heroImage || '/townscribe-img.jpg', Astro.site)} />

		{/* Keeping your components safe below for structural configurations */}
		<BaseHead title={finalTitle} description={finalDescription} />
		<SEO 
			title={finalTitle} 
			description={finalDescription} 
			image={heroImage || '/townscribe-img.jpg'}
			type="article" 
		/>

		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.meta-attribution {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin-top: 0.5em;
				text-transform: capitalize;
			}
			
			/* --- INJECTED: ANONYMOUS SUGGESTIONS BOX STYLING --- */
			.anonymous-feedback-box {
				margin-top: 3em;
				padding: 1.5em;
				background-color: #f8f9fa;
				border-radius: 8px;
				border: 1px solid rgba(var(--gray), 0.2);
			}
			.anonymous-feedback-box h3 {
				margin-top: 0;
				margin-bottom: 0.5em;
				font-size: 1.3rem;
			}
			.anonymous-feedback-box p {
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
				margin-bottom: 1em;
			}
			.anonymous-feedback-box textarea {
				width: 100%;
				padding: 0.75em;
				border-radius: 6px;
				border: 1px solid rgb(var(--gray));
				margin-bottom: 1em;
				font-family: inherit;
				font-size: 1rem;
				resize: vertical;
				box-sizing: border-box;
			}
			.anonymous-feedback-box button {
				background-color: rgb(var(--gray-dark));
				color: white;
				padding: 0.6em 1.5em;
				border: none;
				border-radius: 4px;
				cursor: pointer;
				font-weight: bold;
				font-size: 0.95rem;
				transition: background-color 0.2s ease;
			}
			.anonymous-feedback-box button:hover {
				background-color: #000000;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="meta-attribution">
							By <strong>{author || "TownScribe Staff"}</strong> in <span>{category || "World"}</span>
						</div>
						<hr />
					</div>
					
					{/* Your main article markdown content drops in here */}
					<slot />
					
					<hr />
					
					{/* --- INJECTED: ANONYMOUS CONTRIBUTION FORM --- */}
					<div class="anonymous-feedback-box">
						<h3>💡 Have a Suggestion or News Tip?</h3>
						<p>Submit your thoughts or additional information regarding this story below. Your submission is completely anonymous.</p>
						
						{/* Simply swap out your endpoint URL handling whenever you register a form endpoint */}
						<form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
							<textarea 
								name="suggestion" 
								placeholder="Type your suggestions, updates, or news contributions here..." 
								required 
								rows="4"
							></textarea>
							<button type="submit">Submit Anonymously</button>
						</form>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>