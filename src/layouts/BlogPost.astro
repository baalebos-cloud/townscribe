---
import SEO from '../components/SEO.astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { 
	title, 
	description, 
	pubDate, 
	updatedDate, 
	heroImage, 
	author, 
	category, 
	seoTitle, 
	seoDescription 
} = Astro.props;

const finalTitle = seoTitle || `${title} | TownScribe`;
const finalDescription = seoDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generates a clean template ID based on the URL path for Cusdis target mapping
const pageId = Astro.url.pathname;
---

<html lang="en">
	<head>
		{/* Standard Layout SEO & Core Variables */}
		<title>{finalTitle}</title>
		<meta name="description" content={finalDescription} />
		<link rel="canonical" href={canonicalURL} />

		{/* Open Graph / Facebook */}
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={finalTitle} />
		<meta property="og:description" content={finalDescription} />
		<meta property="og:image" content={new URL(heroImage || '/townscribe-img.jpg', Astro.site)} />
		{pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
		{updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
		<meta property="article:author" content={author || "TownScribe Staff"} />
		<meta property="article:section" content={category || "World"} />

		{/* Twitter / X Meta Cards */}
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={finalTitle} />
		<meta property="twitter:description" content={finalDescription} />
		<meta property="twitter:image" content={new URL(heroImage || '/townscribe-img.jpg', Astro.site)} />

		<BaseHead title={finalTitle} description={finalDescription} />
		<SEO 
			title={finalTitle} 
			description={finalDescription} 
			image={heroImage || '/townscribe-img.jpg'}
			type="article" 
		/>

		{/* --- CLOUDFLARE EDGE ANALYTICS ENGINE --- */}
		<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d503922d74b2443ca33ae2ba8bd66afc"}'></script>

		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.meta-attribution {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin-top: 0.5em;
				text-transform: capitalize;
			}
			
			/* --- REACTION ENGINE STYLING --- */
			.article-interactions {
				margin-top: 3em;
				border-top: 1px solid rgba(var(--gray), 0.2);
				padding-top: 2em;
			}
			.reaction-section {
				text-align: center;
				margin-bottom: 2.5em;
			}
			.reaction-section h4 {
				margin-bottom: 0.75em;
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
			}
			.reactions-wrapper {
				display: flex;
				justify-content: center;
				gap: 1rem;
			}
			.reaction-btn {
				background: #f8f9fa;
				border: 1px solid #ddd;
				border-radius: 25px;
				padding: 0.5rem 1.2rem;
				font-size: 1.2rem;
				cursor: pointer;
				transition: all 0.2s ease;
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}
			.reaction-btn:hover {
				transform: translateY(-2px);
				background: #fff;
				box-shadow: 0 4px 6px rgba(0,0,0,0.05);
			}
			.reaction-btn.active {
				background: #000;
				border-color: #000;
				color: #fff;
			}
			.reaction-btn span {
				font-size: 0.9rem;
				font-weight: bold;
			}

			/* --- PUBLIC ANONYMOUS SUGGESTIONS CONTAINER --- */
			.anonymous-feedback-box {
				padding: 2em;
				background-color: #f8f9fa;
				border-radius: 12px;
				border: 1px solid rgba(var(--gray), 0.15);
				margin-top: 2rem;
			}
			.anonymous-feedback-box h3 {
				margin-top: 0;
				margin-bottom: 0.5em;
				font-size: 1.4rem;
				color: #111;
			}
			.anonymous-feedback-box p {
				font-size: 0.95rem;
				color: #444;
				margin-bottom: 1.5em;
			}
			
			/* Customizing the Cusdis Open UI injection styling */
			#cusdis_thread {
				margin-top: 1rem;
				min-height: 150px;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="meta-attribution">
							By <strong>{author || "TownScribe Staff"}</strong> in <span>{category || "World"}</span>
						</div>
						<hr />
					</div>
					
					<slot />
					
					{/* --- INTERACTION WRAPPER ZONE --- */}
					<div class="article-interactions">
						
						{/* 1. INTERACTIVE ARTICLE REACTIONS BOX */}
						<div class="reaction-section">
							<h4>How do you feel about this news?</h4>
							<div class="reactions-wrapper">
								<button class="reaction-btn" data-reaction="like">👍 <span>0</span></button>
								<button class="reaction-btn" data-reaction="love">❤️ <span>0</span></button>
								<button class="reaction-btn" data-reaction="insightful">💡 <span>0</span></button>
								<button class="reaction-btn" data-reaction="fire">🔥 <span>0</span></button>
							</div>
						</div>

						{/* 2. LIVE ANONYMOUS SUGGESTIONS & UPDATES STREAM (NO EMAIL) */}
						<div class="anonymous-feedback-box">
							<h3>💡 Anonymous Updates & Reader Additions</h3>
							<p>Have a news tip, correction, or extra context about this story? Post it below anonymously. Submissions appear live on this screen immediately after moderation approval.</p>
							
							{/* Secure client-side embedded stream engine container with your exact ID */}
							<div 
								id="cusdis_thread"
								data-host="https://cusdis.com"
								data-app-id="650636a9-98fe-410b-bbda-43b3e61607ff"
								data-page-id={pageId}
								data-page-url={Astro.url.href}
								data-page-title={title}
							></div>
						</div>
						
					</div>
				</div>
			</article>
		</main>
		<Footer />

		{/* ASYNCHRONOUS ENGINE: Renders forms and updates posts live without page reloads */}
		<script is:inline async defer src="https://cusdis.com/js/cusdis.es.js"></script>

		{/* CLIENT SCRIPT: Handles local UI updates for reactions */}
		<script>
			const articlePath = window.location.pathname;
			const storageKey = `townscribe_react_${articlePath}`;
			const buttons = document.querySelectorAll('.reaction-btn');

			buttons.forEach(btn => {
				const type = btn.getAttribute('data-reaction');
				const countSpan = btn.querySelector('span');
				
				let seedCount = Math.abs(articlePath.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) % 24) + 3;
				if (type === 'love') seedCount = Math.floor(seedCount * 0.7);
				if (type === 'insightful') seedCount = Math.floor(seedCount * 0.4);
				if (type === 'fire') seedCount = Math.floor(seedCount * 0.5);

				const savedSelection = localStorage.getItem(storageKey);
				if (savedSelection === type) {
					btn.classList.add('active');
					seedCount += 1;
				}
				
				if (countSpan) countSpan.textContent = seedCount.toString();

				btn.addEventListener('click', () => {
					const currentActive = localStorage.getItem(storageKey);
					
					if (currentActive === type) {
						localStorage.removeItem(storageKey);
						btn.classList.remove('active');
						if (countSpan) countSpan.textContent = (seedCount).toString();
					} else {
						buttons.forEach(b => b.classList.remove('active'));
						localStorage.setItem(storageKey, type || '');
						btn.classList.add('active');
						
						buttons.forEach(b => {
							const t = b.getAttribute('data-reaction');
							const s = b.querySelector('span');
							let base = Math.abs(articlePath.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) % 24) + 3;
							if (t === 'love') base = Math.floor(base * 0.7);
							if (t === 'insightful') base = Math.floor(base * 0.4);
							if (t === 'fire') base = Math.floor(base * 0.5);
							
							if (t === type) base += 1;
							if (s) s.textContent = base.toString();
						});
					}
				});
			});
		</script>
	</body>
</html>
