---
import Analytics from '@vercel/analytics/astro';
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../categories';
import { AUTH_API, COMMENTS_HOST, DEFAULT_IMAGE, SOCIAL_LINKS, VIEW_COUNTER_API, WHATSAPP_CHANNEL_URL } from '../consts';
import SocialIcon from '../components/SocialIcon.astro';
import { getSortedPosts, postUrl, relatedPosts as pickRelated } from '../posts';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import InArticleAd from '../components/InArticleAd.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { getYouTubeId } from '../youtube-id';

type Props = CollectionEntry<'blog'>['data'] & { readMinutes?: number };

const { 
    title, 
    description, 
    pubDate, 
    updatedDate, 
    heroImage, 
    author, 
    category, 
    seoTitle, 
    seoDescription,
    seoKeyword,
    gallery = [],
    youtubeUrl,
    readMinutes
} = Astro.props;

const finalTitle = seoTitle || `${title} | TownScribe`;
const finalDescription = seoDescription || description;


const currentSlug = Astro.params.slug;
const pageId = `/blog/${currentSlug}`;

const allPosts = await getSortedPosts();

const currentPostIndex = allPosts.findIndex((post) => post.id === currentSlug);
const nextPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const prevPost = currentPostIndex >= 0 && currentPostIndex < allPosts.length - 1 ? allPosts[currentPostIndex + 1] : null;

// Same-category stories first, topped up with the latest news
const relatedPosts = pickRelated(allPosts, { id: currentSlug ?? '', category });

const extractedVideoId = getYouTubeId(youtubeUrl);
const FACEBOOK_URL = SOCIAL_LINKS.find((l) => l.id === 'facebook')!.url;

// Share links (no tracking scripts; plain URLs)
const shareUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site ?? 'https://news.townscribe.org').href;
const shareText = encodeURIComponent(title);
const shareLinks = {
    x: `https://x.com/intent/post?text=${shareText}&url=${encodeURIComponent(shareUrl)}`,
    whatsapp: `https://wa.me/?text=${encodeURIComponent(`${title} ${shareUrl}`)}`,
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
};
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={finalTitle}
            description={finalDescription}
            image={heroImage || DEFAULT_IMAGE}
            seoKeyword={seoKeyword}
            author={author}
            pubDate={pubDate}
            updatedDate={updatedDate}
            category={category}
        />
        <Analytics />

        <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d503922d74b2443ca33ae2ba8bd66afc"}'></script>

        <style>
            .article-page { display: grid; grid-template-columns: minmax(0, 1fr) 300px; grid-template-areas: "main aside" "comments aside"; column-gap: 48px; padding-block: 1.75rem 1rem; }
            .article-main { grid-area: main; min-width: 0; }
            .related { grid-area: aside; align-self: start; position: sticky; top: 64px; }
            .comments { grid-area: comments; min-width: 0; }

            .article-head { display: grid; gap: 12px; }
            .article-head h1 { margin: 0; font-size: clamp(1.8rem, 1.2rem + 2.2vw, 2.6rem); line-height: 1.08; }
            .standfirst { margin: 0; font: 400 1.2rem/1.45 var(--font-read); color: var(--ink-2); }
            .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding-block: 12px; border-block: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
            .byline strong { color: var(--ink); }
            .byline-actions { margin-left: auto; display: flex; gap: 8px; align-items: center; }
            .icon-btn { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink-2); display: inline-grid; place-items: center; }
            .icon-btn:hover { border-color: var(--red); color: var(--red); }
            .bookmark-btn { display: inline-flex; align-items: center; gap: 0.4rem; background: none; border: 1px solid var(--line); border-radius: 999px; padding: 0 0.85rem; height: 34px; font: 600 0.82rem var(--font-ui); color: var(--ink-2); cursor: pointer; }
            .bookmark-btn:hover { border-color: var(--red); color: var(--red); }
            .bookmark-btn.bookmarked { background: var(--red); border-color: var(--red); color: #fff; }

            .article-media { margin: 1.25rem 0 0; }
            .article-media img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 4px; }

            /* Reading column */
            .body { max-width: 68ch; margin-top: 1.5rem; font: 400 1.16rem/1.72 var(--font-read); color: var(--ink); }
            .body :global(p) { margin: 0 0 1.15em; }
            .body :global(h2), .body :global(h3) { margin: 1.5em 0 0.5em; }
            .body :global(h2) { font-size: 1.5rem; }
            .body :global(h3) { font-size: 1.25rem; }
            .body :global(a) { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
            .body :global(img) { display: block; margin: 1.5em 0; border-radius: 4px; }
            .body :global(ul), .body :global(ol) { padding-left: 1.3em; margin: 0 0 1.15em; }
            .body :global(li) { margin-bottom: 0.4em; }
            .body :global(strong) { color: var(--ink); }

            .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem; margin: 2rem 0; }
            .gallery img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 4px; }

            .follow-strip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin: 2rem 0; padding: 1rem 1.15rem; border: 1px solid var(--line); border-left: 4px solid #1f8f4e; border-radius: 6px; background: var(--surface); }
            .follow-strip p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
            .follow-strip strong { color: var(--ink); }
            .follow-links { display: flex; flex-wrap: wrap; gap: 8px; }
            .follow-links a { display: inline-flex; align-items: center; gap: 7px; padding: 0.5rem 0.95rem; border-radius: 999px; font-weight: 700; font-size: 0.85rem; color: #fff; }
            .follow-wa { background: #1f8f4e; }
            .follow-wa:hover { background: #18763f; color: #fff; }
            .follow-fb { background: #1b5fc1; }
            .follow-fb:hover { background: #154c9c; color: #fff; }
            .bookmark-toast { position: fixed; bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px)); left: 50%; transform: translateX(-50%) translateY(120px); background: var(--ink); color: var(--paper); padding: 0.65rem 1.25rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; z-index: 9999; transition: transform 0.3s ease; white-space: nowrap; }
            .bookmark-toast.show { transform: translateX(-50%) translateY(0); }

            .nav-pagination { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; border-block: 1px solid var(--line); padding: 1.25rem 0; margin: 2.5rem 0 0; }
            .nav-block { display: grid; gap: 4px; color: var(--ink); }
            .nav-block.next { text-align: right; }
            .nav-label { font: 700 0.72rem var(--font-ui); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
            .nav-title { font: 700 0.98rem/1.3 var(--font-head); }
            .nav-block:hover .nav-title { color: var(--red); }

            .related h2, .comments h2 { font: 800 0.8rem var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; padding-bottom: 8px; border-bottom: 2px solid var(--ink); margin: 0 0 4px; }
            .related-card { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--ink); }
            .related-card img { width: 92px; height: 69px; object-fit: cover; border-radius: 4px; }
            .related-text { display: grid; gap: 4px; align-content: start; }
            .related-title { font: 700 0.92rem/1.3 var(--font-head); }
            .related-card:hover .related-title { color: var(--red); }
            .related-date { font-size: 0.75rem; color: var(--muted); }

            .comments { margin-top: 2.5rem; }
            .comments p { color: var(--ink-2); font-size: 0.95rem; margin: 0.75rem 0 1rem; }
            #remark42 { min-height: 300px; width: 100%; }

            @media (max-width: 980px) {
                .article-page { grid-template-columns: minmax(0, 1fr); grid-template-areas: "main" "aside" "comments"; }
                .related { position: static; margin-top: 2.5rem; }
            }
            @media (max-width: 640px) {
                .standfirst { font-size: 1.08rem; }
                .body { font-size: 1.08rem; }
                .byline-actions { margin-left: 0; width: 100%; }
                .nav-pagination { grid-template-columns: 1fr; }
                .nav-block.next { text-align: left; }
            }
        </style>
    </head>

    <body>
        <Header />
        <main class="wrap article-page">
            <article class="article-main">
                <header class="article-head">
                    <a class="kicker" href={`/category/${category}`}>{categoryLabel(category)}</a>
                    <h1>{title}</h1>
                    {description && <p class="standfirst">{description}</p>}
                    <div class="byline">
                        <span class="byline-who">By <strong>{author || "TownScribe Staff"}</strong></span>
                        <span><FormattedDate date={pubDate} /></span>
                        {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
                        {readMinutes && <span>{readMinutes} min read</span>}
                        <span class="views"><span id="view-count-number">— views</span></span>
                        <span class="byline-actions">
                            <a class="icon-btn" href={shareLinks.whatsapp} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.2A8.5 8.5 0 1 1 21 11.5z"/></svg>
                            </a>
                            <a class="icon-btn" href={shareLinks.x} target="_blank" rel="noopener" aria-label="Share on X">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </a>
                            <a class="icon-btn" href={shareLinks.facebook} target="_blank" rel="noopener" aria-label="Share on Facebook">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M14 8h3V4h-3c-2.8 0-4 1.7-4 4.2V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.2-.6.6-.6z"/></svg>
                            </a>
                            <button id="bookmark-btn" class="bookmark-btn" title="Save article">
                                <svg id="bookmark-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <span id="bookmark-label">Save</span>
                            </button>
                        </span>
                    </div>
                </header>

                {extractedVideoId ? (
                    <div class="article-media">
                        <VideoPlayer videoId={extractedVideoId} youtubeUrl={youtubeUrl} title={title} />
                    </div>
                ) : heroImage && (
                    <figure class="article-media">
                        <img width={1020} height={638} src={heroImage} alt="" fetchpriority="high" decoding="async" />
                    </figure>
                )}

                <div class="body">
                    <slot />
                </div>

                {gallery.length > 0 && (
                    <section class="gallery" aria-label="Photo gallery">
                        {gallery.map((src) => (
                            <a href={src} target="_blank" rel="noopener">
                                <img src={src} alt="" width="480" height="320" loading="lazy" decoding="async" />
                            </a>
                        ))}
                    </section>
                )}

                <aside class="follow-strip" aria-label="Follow TownScribe">
                    <p><strong>Get TownScribe news first.</strong> Follow our WhatsApp Channel or Facebook page.</p>
                    <div class="follow-links">
                        <a class="follow-wa" href={WHATSAPP_CHANNEL_URL} target="_blank" rel="noopener noreferrer"><SocialIcon id="whatsapp" size={17} /> WhatsApp Channel</a>
                        <a class="follow-fb" href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer"><SocialIcon id="facebook" size={16} /> Facebook</a>
                    </div>
                </aside>

                <InArticleAd />

                <nav class="nav-pagination" aria-label="More stories">
                    {prevPost ? (
                        <a href={postUrl(prevPost)} class="nav-block prev">
                            <span class="nav-label">← Previous story</span>
                            <span class="nav-title">{prevPost.data.title}</span>
                        </a>
                    ) : (
                        <span class="nav-block"></span>
                    )}
                    {nextPost ? (
                        <a href={postUrl(nextPost)} class="nav-block next">
                            <span class="nav-label">Next story →</span>
                            <span class="nav-title">{nextPost.data.title}</span>
                        </a>
                    ) : (
                        <span class="nav-block"></span>
                    )}
                </nav>
            </article>

            <aside class="related" aria-labelledby="related-title">
                <h2 id="related-title">Related News</h2>
                {relatedPosts.map((post: CollectionEntry<'blog'>) => (
                    <a href={postUrl(post)} class="related-card">
                        <img src={post.data.heroImage || DEFAULT_IMAGE} alt="" width="92" height="69" loading="lazy" decoding="async" />
                        <span class="related-text">
                            <span class="kicker">{categoryLabel(post.data.category)}</span>
                            <span class="related-title">{post.data.title}</span>
                            <span class="related-date"><FormattedDate date={post.data.pubDate} /></span>
                        </span>
                    </a>
                ))}
            </aside>

            <section class="comments" aria-labelledby="comments-title">
                <h2 id="comments-title">Community Additions</h2>
                <p>Have a news tip, correction, or extra context about this story? Post it below. Submissions appear here straight away.</p>
                <div id="remark42"></div>
            </section>
        </main>

        <div id="bookmark-toast" class="bookmark-toast"></div>
        <Footer />

        <script is:inline define:vars={{ 
            AUTH_API,
            currentSlug,
            title,
            heroImage: heroImage || DEFAULT_IMAGE,
            category
        }}>
            const bookmarkBtn   = document.getElementById('bookmark-btn');
            const bookmarkLabel = document.getElementById('bookmark-label');
            const bookmarkIcon  = document.getElementById('bookmark-icon');
            const bookmarkToast = document.getElementById('bookmark-toast');
            let isBookmarked = false;

            function showToast(msg) {
                if (!bookmarkToast) return;
                bookmarkToast.textContent = msg;
                bookmarkToast.classList.add('show');
                setTimeout(() => bookmarkToast.classList.remove('show'), 2500);
            }

            function setBookmarked(state) {
                isBookmarked = state;
                if (!bookmarkBtn || !bookmarkLabel || !bookmarkIcon) return;
                bookmarkBtn.classList.toggle('bookmarked', state);
                bookmarkLabel.textContent = state ? 'Saved' : 'Save';
                bookmarkIcon.setAttribute('fill', state ? 'currentColor' : 'none');
            }

            async function initBookmark() {
                if (!window.TSAuth || !window.TSAuth.isLoggedIn()) return;
                const token = window.TSAuth.getToken();
                try {
                    const res = await fetch(`${AUTH_API}/bookmarks`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (!res.ok) return;
                    const { bookmarks } = await res.json();
                    setBookmarked(bookmarks.some(b => b.article_slug === currentSlug));
                } catch {}
            }

            async function toggleBookmark() {
                if (!window.TSAuth || !window.TSAuth.isLoggedIn()) {
                    document.getElementById('auth-signin-btn')?.click();
                    showToast('Sign in to save articles');
                    return;
                }
                const token = window.TSAuth.getToken();
                if (isBookmarked) {
                    try {
                        await fetch(`${AUTH_API}/bookmarks?slug=${encodeURIComponent(currentSlug)}`, {
                            method: 'DELETE',
                            headers: { 'Authorization': `Bearer ${token}` }
                        });
                        setBookmarked(false);
                        showToast('Removed from bookmarks');
                    } catch { showToast('Failed to remove bookmark'); }
                } else {
                    try {
                        const res = await fetch(`${AUTH_API}/bookmarks`, {
                            method: 'POST',
                            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                            body: JSON.stringify({ slug: currentSlug, title, image: heroImage, category })
                        });
                        if (res.ok) { setBookmarked(true); showToast('✅ Article saved to bookmarks'); }
                        else showToast('Failed to save bookmark');
                    } catch { showToast('Failed to save bookmark'); }
                }
            }

            function trackReadingHistory() {
                try {
                    const history = JSON.parse(localStorage.getItem('ts_reading_history') || '[]');
                    const entry = { slug: currentSlug, title, category, image: heroImage, readAt: Date.now() };
                    const filtered = history.filter(h => h.slug !== currentSlug);
                    filtered.unshift(entry);
                    localStorage.setItem('ts_reading_history', JSON.stringify(filtered.slice(0, 50)));
                } catch {}
            }

            bookmarkBtn?.addEventListener('click', toggleBookmark);

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => { initBookmark(); trackReadingHistory(); });
            } else {
                initBookmark();
                trackReadingHistory();
            }
        </script>

        <script is:inline define:vars={{ pageId, title, COMMENTS_HOST }}>
            window.remark_config = {
                host: COMMENTS_HOST,
                site_id: 'remark',
                url: 'https://news.townscribe.org' + window.location.pathname.replace(/\/$/, ""),
                id: pageId,
                title: title,
                locale: 'en',
                max_ans: 5,
                show_anonymous: true
            };
            function loadRemark42() {
                if (document.getElementById('remark42-script')) return;
                var d = document, s = d.createElement('script');
                s.id = 'remark42-script';
                s.src = window.remark_config.host + '/web/embed.js';
                s.defer = true;
                (d.head || d.body).appendChild(s);
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadRemark42);
            } else {
                loadRemark42();
            }
        </script>
        <script is:inline define:vars={{ VIEW_COUNTER_API }}>
            const workerUrl = VIEW_COUNTER_API;
            fetch(`${workerUrl}?slug=${window.location.pathname}`, { method: "POST" })
                .then(res => res.json())
                .then(data => {
                    const display = document.getElementById("view-count-number");
                    if (display) display.textContent = `${Number(data.views || 0).toLocaleString()} views`;
                })
                .catch(() => {
                    const display = document.getElementById("view-count-number");
                    if (display) display.textContent = "— views";
                });
        </script>
    </body>
</html>
