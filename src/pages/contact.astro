---
import Layout from '../layouts/Page.astro';
---

<Layout
	title="Contact Us - Townscribe Media"
	description="Get in touch with the Townscribe editorial and support team."
>
  <div class="contact-container">
    <article class="contact-content">
      <h1>Contact Us</h1>
      
      <p class="lead-text">
        Have a question, feedback, or a story pitch for our writing team? We would love to hear from you.
      </p>

      <div class="email-card">
        <div class="card-icon">📧</div>
        <div class="card-info">
          <p class="card-label">You can reach the Townscribe editorial and support team directly at our professional inbox:</p>
          <a href="mailto:info@townscribe.org" class="email-link">info@townscribe.org</a>
        </div>
      </div>

      <p class="notice-text">
        We typically respond to all inquiries within 24–48 business hours.
      </p>
    </article>
  </div>
</Layout>

<style>
  .contact-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.7;
    color: var(--ink);
  }

  .contact-content h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
    color: var(--ink);
  }

  .lead-text {
    font-size: 1.2rem;
    color: var(--ink-2);
    margin-bottom: 2.5rem;
  }

  /* Elegant card styling for your brand email */
  .email-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--red); /* Premium teal accent matching your footer */
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2.5rem;
  }

  .card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .card-label {
    margin: 0 0 0.5rem 0;
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  .email-link {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--link);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .notice-text {
    font-style: italic;
    color: var(--muted);
    font-size: 1rem;
  }

  @media (max-width: 640px) {
    .contact-container {
      padding: 2rem 1rem;
    }
    .contact-content h1 {
      font-size: 2rem;
    }
    .email-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .email-link {
      font-size: 1.15rem;
    }
  }
</style>
