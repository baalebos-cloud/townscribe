---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import PostGrid from '../components/PostGrid.astro';
import TvIcon from '../components/TvIcon.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { getAllVideos } from '../youtube';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts, pageCount, pageSlice } from '../posts';

const all = await getSortedPosts();
const latest = pageSlice(all, 1);
const videos = await getAllVideos();
const liveNow = videos.find((v) => v.live);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	{/* admin.townscribe.org serves the same site; send editors straight to the CMS */}
	<script is:inline slot="head">
		if (window.location.hostname === 'admin.townscribe.org' && !window.location.pathname.startsWith('/admin')) {
			window.location.replace('/admin/');
		}
	</script>

	<div class="home">
		<h1 class="sr-only">TownScribe Media — latest news</h1>

		{liveNow && (
			<a class="live-banner" href={liveNow.href}>
				<span class="live-pill">● LIVE</span>
				<span class="live-title">{liveNow.title}</span>
				<span class="live-cta">Watch now →</span>
			</a>
		)}
		<div class="welcome-section">
			{/* --- CORRECTED BOTTOM SOCIAL INTERFACE LINK BAR --- */}
			<p class="social-inline-links">
				Looking for a way to carry out your publicity or your blog? Connect with us:
				<span class="inline-social-group">
				<a class="inline-icon insta" href="https://www.instagram.com/townscribenews?igsh=MTZxM3p1b3Bub2s2ag==" target="_blank" aria-label="Instagram Profile">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
				</a>
				<a class="inline-icon x-corp" href="https://x.com/townscribenews?s=21" target="_blank" aria-label="X (Twitter) Profile">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
				<a class="inline-icon tv" href="/tv" aria-label="TownScribe TV" title="TownScribe TV">
					<TvIcon size={24} />
				</a>
				</span>
			</p>
		</div>

		<section>
			<h2 class="articles-heading">Latest News Updates</h2>
			<PostGrid posts={latest} />
			{/* Page 1 of /blog is the same list, so "Older" jumps straight to page 2 */}
			<Pagination base="/blog" current={1} total={pageCount(all.length)} />
		</section>

		{videos.length > 0 && (
			<section class="tv-strip">
				<div class="tv-strip-head">
					<h2 class="articles-heading"><TvIcon size={26} /> TownScribe TV</h2>
					<a href="/tv">All videos →</a>
				</div>
				<VideoGrid videos={videos.slice(0, 4)} />
			</section>
		)}
	</div>
</BaseLayout>

<style>
	.home {
		width: 1100px;
		max-width: 100%;
		margin: 0 auto;
		padding: 1rem 0 2rem;
	}
	.welcome-section {
		margin-bottom: 4rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
		padding-bottom: 2rem;
	}
	h1 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}
	p {
		line-height: 1.6;
		color: #333;
	}
	
	/* --- BOTTOM CONTENT LINE SOCIAL BLOCKS --- */
	.social-inline-links {
		margin-top: 1.5rem;
		line-height: 2;
	}
	.inline-social-group {
		display: inline-flex;
		align-items: center;
		gap: 1.25rem;
		margin-left: 0.5rem;
		vertical-align: middle;
	}
	.inline-icon {
		color: #111;
		transition: color 0.2s ease, transform 0.2s ease;
		display: inline-flex;
		align-items: center;
	}
	.inline-icon:hover {
		transform: translateY(-2px);
	}
	.inline-icon.insta:hover { color: #E1306C; }
	.inline-icon.x-corp:hover { color: #000000; }
	.inline-icon.tv:hover { color: #dc2626; }
	.articles-heading {
		font-size: 1.8rem;
		margin-bottom: 2rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}
	.live-banner {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		background: #111827;
		color: #fff;
		text-decoration: none;
		padding: 0.85rem 1.1rem;
		border-radius: 10px;
		margin-bottom: 2rem;
	}
	.live-pill {
		background: #dc2626;
		font-weight: 800;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		padding: 0.3rem 0.55rem;
		border-radius: 4px;
		animation: pulse 1.6s ease-in-out infinite;
	}
	.live-title {
		flex: 1;
		font-weight: 600;
		line-height: 1.3;
	}
	.live-cta {
		white-space: nowrap;
		color: #fca5a5;
		font-weight: 700;
	}
	@keyframes pulse {
		50% { opacity: 0.6; }
	}
	@media (prefers-reduced-motion: reduce) {
		.live-pill { animation: none; }
	}
	.tv-strip {
		margin-top: 3.5rem;
	}
	.tv-strip-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.tv-strip-head a {
		color: #dc2626;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.tv-strip .articles-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.tv-strip .articles-heading::after {
		flex-basis: 100%;
	}
	.articles-heading::after {
		content: '';
		display: block;
		width: 60px;
		height: 4px;
		background: #14b8a6;
		margin-top: 0.5rem;
	}
</style>
