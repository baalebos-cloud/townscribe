---
// Front page: breaking strip, live banner, lead story with a timed "Latest"
// list, category sections and the TownScribe TV band.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import StoryCard from '../components/StoryCard.astro';
import TvIcon from '../components/TvIcon.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { CATEGORIES } from '../categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts, postUrl } from '../posts';
import { getAllVideos } from '../youtube';

const all = await getSortedPosts();
const now = new Date();

// Breaking strip: newest story marked "Breaking news" in the last 48 hours
const breaking = all.find((p) => p.data.breaking && now.valueOf() - p.data.pubDate.valueOf() < 48 * 3600 * 1000);

const [lead, ...rest] = all;
const stack = rest.slice(0, 2);
const latest = rest.slice(2, 9);
const shown = new Set([lead, ...stack, ...latest].map((p) => p?.id));

// Category sections: up to 6 categories that have at least 4 more stories
const SECTION_ORDER = ['politics', 'governance', 'crime', 'news', 'business', 'world', 'sport', 'entertainment', 'lifestyle', 'health', 'technology', 'pidgin-news'];
const sections = SECTION_ORDER.map((slug) => {
	const posts = all.filter((p) => p.data.category === slug && !shown.has(p.id)).slice(0, 4);
	const label = CATEGORIES.find((c) => c.slug === slug)?.label ?? slug;
	return { slug, label, posts };
})
	.filter((s) => s.posts.length === 4)
	.slice(0, 6);
const sectionsBeforeTv = sections.slice(0, 2);
const sectionsAfterTv = sections.slice(2);

const videos = await getAllVideos();
const liveNow = videos.find((v) => v.live);

// "Latest" list: time for today's stories (Lagos time), short date for older ones
const dayKey = (d: Date) => d.toLocaleDateString('en-GB', { timeZone: 'Africa/Lagos' });
const timeFmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Africa/Lagos' });
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'Africa/Lagos' });
const stamp = (d: Date) => (dayKey(d) === dayKey(now) ? timeFmt.format(d) : dateFmt.format(d));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	{/* admin.townscribe.org serves the same site; send editors straight to the CMS */}
	<script is:inline slot="head">
		if (window.location.hostname === 'admin.townscribe.org' && !window.location.pathname.startsWith('/admin')) {
			window.location.replace('/admin/');
		}
	</script>

	<h1 class="sr-only">TownScribe Media — latest news</h1>

	{breaking && (
		<div class="breaking">
			<div class="wrap breaking-row">
				<span class="tag">Breaking</span>
				<a href={postUrl(breaking)}>{breaking.data.title}</a>
			</div>
		</div>
	)}

	<div class="wrap">
		{liveNow && (
			<a class="live-banner" href={liveNow.href}>
				<span class="dot" aria-hidden="true"></span>
				<span class="tag">Live</span>
				<span class="live-title">TownScribe TV: {liveNow.title}</span>
				<span class="live-cta">Watch now →</span>
			</a>
		)}

		{lead && (
			<section class="front" aria-label="Top stories">
				<div class="front-lead">
					<StoryCard post={lead} variant="lead" eager />
				</div>
				<div class="front-stack">
					{stack.map((p) => <StoryCard post={p} variant="stack" eager />)}
				</div>
				<aside class="front-latest" aria-labelledby="latest-title">
					<h2 id="latest-title">Latest</h2>
					<ol>
						{latest.map((p) => (
							<li>
								<time datetime={p.data.pubDate.toISOString()}>{stamp(p.data.pubDate)}</time>
								<a href={postUrl(p)}>{p.data.title}</a>
							</li>
						))}
					</ol>
					<a class="all-news" href="/blog">All news →</a>
				</aside>
			</section>
		)}

		{sectionsBeforeTv.map((s) => (
			<section class="home-section" aria-labelledby={`sec-${s.slug}`}>
				<div class="section-head">
					<h2 id={`sec-${s.slug}`}>{s.label}</h2>
					<a href={`/category/${s.slug}`}>More {s.label.toLowerCase()} →</a>
				</div>
				<PostGrid posts={s.posts} showCategory={false} />
			</section>
		))}
	</div>

	{videos.length > 0 && (
		<section class="tv-band" aria-labelledby="sec-tv">
			<div class="wrap">
				<div class="section-head">
					<h2 id="sec-tv"><TvIcon size={24} /> TownScribe TV</h2>
					<a href="/tv">All videos →</a>
				</div>
				<VideoGrid videos={videos.slice(0, 4)} dark />
			</div>
		</section>
	)}

	<div class="wrap">
		{sectionsAfterTv.map((s) => (
			<section class="home-section" aria-labelledby={`sec-${s.slug}`}>
				<div class="section-head">
					<h2 id={`sec-${s.slug}`}>{s.label}</h2>
					<a href={`/category/${s.slug}`}>More {s.label.toLowerCase()} →</a>
				</div>
				<PostGrid posts={s.posts} showCategory={false} />
			</section>
		))}

		<p class="more-news"><a href="/blog">See all news →</a></p>
	</div>
</BaseLayout>

<style>
	.tag {
		flex-shrink: 0;
		font: 800 0.68rem/1 var(--font-ui);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--red-ink);
		background: var(--red);
		padding: 6px 8px;
		border-radius: 3px;
	}

	/* Breaking strip */
	.breaking {
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.breaking-row {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
	}
	.breaking a {
		color: var(--ink);
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
	}
	.breaking a:hover {
		color: var(--red);
	}

	/* Live banner */
	.live-banner {
		display: flex;
		align-items: center;
		gap: 12px;
		background: var(--tv-bg);
		color: var(--tv-ink);
		border-radius: 8px;
		padding: 12px 14px;
		margin-top: 20px;
	}
	.live-banner:hover {
		color: var(--tv-ink);
	}
	.dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--red);
		flex-shrink: 0;
		animation: ping 1.8s infinite;
	}
	@keyframes ping {
		0% { box-shadow: 0 0 0 0 var(--red); }
		70%, 100% { box-shadow: 0 0 0 8px transparent; }
	}
	.live-title {
		flex: 1;
		min-width: 0;
		font: 700 0.98rem/1.3 var(--font-head);
	}
	.live-cta {
		white-space: nowrap;
		font-weight: 700;
		font-size: 0.85rem;
		color: #ff9aa8;
	}

	/* Front: lead | stack | latest */
	.front {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr) minmax(0, 0.9fr);
		gap: 28px;
		padding-block: 24px 8px;
	}
	.front-stack {
		display: grid;
		gap: 18px;
		align-content: start;
	}
	.front-stack > :global(.story:last-child) {
		border-bottom: 0;
	}
	.front-latest h2 {
		font: 800 0.8rem var(--font-ui);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding-bottom: 8px;
		border-bottom: 2px solid var(--ink);
		margin: 0 0 4px;
	}
	.front-latest ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.front-latest li {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr);
		gap: 10px;
		padding: 11px 0;
		border-bottom: 1px solid var(--line);
	}
	.front-latest time {
		font: 700 0.75rem var(--font-ui);
		color: var(--red);
		font-variant-numeric: tabular-nums;
		padding-top: 2px;
	}
	.front-latest li a {
		font: 600 0.88rem/1.35 var(--font-ui);
		color: var(--ink);
	}
	.front-latest li a:hover {
		color: var(--red);
	}
	.all-news,
	.more-news a {
		display: inline-block;
		margin-top: 12px;
		font-weight: 700;
		font-size: 0.88rem;
		color: var(--red);
	}
	.more-news {
		margin: 2rem 0 0;
		text-align: center;
	}

	.home-section {
		padding-top: 2rem;
	}

	/* TownScribe TV band */
	.tv-band {
		background: var(--tv-bg);
		color: var(--tv-ink);
		margin-top: 2.5rem;
		padding-block: 1.75rem 2rem;
	}
	.tv-band .section-head {
		border-top-color: var(--tv-ink);
	}
	.tv-band .section-head h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--tv-ink);
	}
	.tv-band .section-head a {
		color: #ff9aa8;
	}

	@media (max-width: 980px) {
		.front {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		}
		.front-latest {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 640px) {
		.front {
			grid-template-columns: 1fr;
			gap: 18px;
			padding-top: 16px;
		}
		.live-cta {
			display: none;
		}
	}
</style>
