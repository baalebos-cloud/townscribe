---
// Landing page for the emailed "Reset Password" link: /reset-password?token=…
// Private page: not indexed, no ads, and the token is removed from the address
// bar before anything else on the page runs.
import Page from '../layouts/Page.astro';
import { AUTH_API } from '../consts';
---

<Page title="Reset your password" description="Choose a new password for your TownScribe account." noindex ads={false}>
	<Fragment slot="head">
		<meta name="referrer" content="no-referrer" />
		<script is:inline>
			(function () {
				var params = new URLSearchParams(location.search);
				window.__tsResetToken = params.get('token') || '';
				if (params.has('token')) history.replaceState(null, '', location.pathname);
			})();
		</script>
	</Fragment>

	<section class="reset" aria-labelledby="reset-title">
		<h1 id="reset-title" class="reset-title">Choose a new password</h1>

		<div id="reset-missing" class="reset-note" hidden>
			<p>This reset link is incomplete or has expired. Links work once and only for 30 minutes.</p>
			<a class="reset-btn" href="/?forgot=1">Send me a new link</a>
		</div>

		<form id="reset-form" class="reset-form" novalidate hidden>
			<p class="reset-sub">Your new password must be at least 8 characters.</p>
			<div id="reset-error" class="reset-msg reset-msg--error" role="alert" hidden></div>
			<label for="reset-password">New password</label>
			<input type="password" id="reset-password" autocomplete="new-password" minlength="8" required />
			<label for="reset-confirm">Confirm new password</label>
			<input type="password" id="reset-confirm" autocomplete="new-password" minlength="8" required />
			<label class="reset-show"><input type="checkbox" id="reset-show" /> Show passwords</label>
			<button type="submit" class="reset-btn" id="reset-submit">Save new password</button>
		</form>

		<div id="reset-done" class="reset-msg reset-msg--ok" role="status" hidden>
			✅ Your password has been changed. Taking you to sign in…
		</div>
	</section>

	<script is:inline define:vars={{ AUTH_API }}>
		(function () {
			var token = window.__tsResetToken || '';
			var form = document.getElementById('reset-form');
			var missing = document.getElementById('reset-missing');
			var errorBox = document.getElementById('reset-error');
			var done = document.getElementById('reset-done');
			var pw = document.getElementById('reset-password');
			var confirmPw = document.getElementById('reset-confirm');
			var submit = document.getElementById('reset-submit');

			if (!/^[0-9a-f]{64}$/.test(token)) { missing.hidden = false; return; }
			form.hidden = false;
			pw.focus();

			function fail(msg) { errorBox.textContent = msg; errorBox.hidden = false; }

			document.getElementById('reset-show').addEventListener('change', function (e) {
				pw.type = confirmPw.type = e.target.checked ? 'text' : 'password';
			});

			form.addEventListener('submit', async function (e) {
				e.preventDefault();
				errorBox.hidden = true;
				if (pw.value.length < 8) return fail('Password must be at least 8 characters.');
				if (pw.value !== confirmPw.value) return fail('The two passwords do not match.');
				submit.disabled = true;
				submit.textContent = 'Saving…';
				try {
					var res = await fetch(AUTH_API + '/reset-password', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ token: token, password: pw.value }),
					});
					var data = await res.json().catch(function () { return {}; });
					if (!res.ok) {
						if (res.status === 400 && /expired|invalid|used/i.test(data.error || '')) {
							form.hidden = true;
							missing.hidden = false;
							return;
						}
						return fail(data.error || 'Could not change your password. Please try again.');
					}
					// Old sessions are signed out by the server; clear this browser's too.
					try { localStorage.removeItem('ts_auth_token'); localStorage.removeItem('ts_auth_user'); } catch (_) {}
					form.hidden = true;
					done.hidden = false;
					setTimeout(function () { location.href = '/?reset=1'; }, 1500);
				} catch (_) {
					fail('Network error. Please try again.');
				} finally {
					submit.disabled = false;
					submit.textContent = 'Save new password';
				}
			});
		})();
	</script>
</Page>

<style>
	.reset { max-width: 420px; margin: 0 auto; font-family: var(--font-ui, inherit); }
	.reset-title { font: 800 1.8rem/1.2 var(--font-head, inherit); margin: 0 0 0.5rem; color: var(--ink); }
	.reset-sub { color: var(--muted); font-size: 0.95rem; margin: 0 0 1.25rem; }
	.reset-form { display: flex; flex-direction: column; }
	.reset-form label { font-size: 0.875rem; font-weight: 600; color: var(--ink-2); margin-bottom: 0.35rem; }
	.reset-form input[type='password'],
	.reset-form input[type='text'] {
		background: var(--paper); color: var(--ink); width: 100%; padding: 0.7rem 0.85rem; margin-bottom: 1rem;
		border: 1.5px solid var(--line); border-radius: 8px; font-size: 1rem; box-sizing: border-box;
	}
	.reset-form input:focus { outline: none; border-color: var(--red); }
	.reset-form .reset-show { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; color: var(--muted); margin-bottom: 1rem; }
	.reset-btn {
		display: inline-flex; justify-content: center; width: 100%; background: var(--red); color: #fff; border: 0;
		padding: 0.8rem; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; text-decoration: none;
	}
	.reset-btn:hover { background: #b91c1c; color: #fff; }
	.reset-btn:disabled { opacity: 0.7; cursor: wait; }
	.reset-note p { color: var(--ink-2); margin: 0 0 1rem; }
	.reset-msg { padding: 0.7rem 0.85rem; border-radius: 8px; font-size: 0.9rem; margin-bottom: 1rem; }
	.reset-msg--error { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
	.reset-msg--ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
	[hidden] { display: none !important; }
</style>
