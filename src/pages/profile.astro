---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Profile | TownScribe" description="Manage your TownScribe account">
  <main class="profile-page">
    <div class="page-container">

      <!-- Auth gate -->
      <div id="auth-gate" class="auth-gate" style="display:none;">
        <div class="gate-card">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#dc2626" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <h2>Sign in to view your profile</h2>
          <p>Create an account or sign in to manage your TownScribe profile.</p>
          <button id="gate-signin-btn" class="btn-primary">Sign In</button>
        </div>
      </div>

      <!-- Profile content -->
      <div id="profile-content" style="display:none;">

        <div class="profile-header">
          <div class="avatar-wrap">
            <div id="profile-avatar" class="avatar-large">?</div>
          </div>
          <div class="profile-info">
            <h1 id="profile-name"  class="profile-name">—</h1>
            <p  id="profile-email" class="profile-email">—</p>
            <span id="profile-role" class="profile-badge">Member</span>
          </div>
        </div>

        <div class="profile-grid">

          <!-- Account details card -->
          <section class="profile-card">
            <h2 class="card-heading">Account Details</h2>
            <div class="detail-row">
              <span class="detail-label">Display Name</span>
              <span id="detail-name" class="detail-value">—</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Email</span>
              <span id="detail-email" class="detail-value">—</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Member Since</span>
              <span id="detail-joined" class="detail-value">—</span>
            </div>
          </section>

          <!-- Bookmarks summary card -->
          <section class="profile-card">
            <h2 class="card-heading">Reading Activity</h2>
            <div class="stat-row">
              <div class="stat-box">
                <span id="stat-bookmarks" class="stat-num">0</span>
                <span class="stat-label">Bookmarks</span>
              </div>
            </div>
            <a href="/bookmarks" class="btn-outline">View All Bookmarks →</a>
          </section>

          <!-- Danger zone -->
          <section class="profile-card danger-card">
            <h2 class="card-heading danger-heading">Account Actions</h2>
            <button id="signout-profile-btn" class="btn-danger">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              Sign Out
            </button>
          </section>

        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<script is:inline>
  const AUTH_API       = 'https://townscribe-auth.jayeolaoluwadamilare.workers.dev';
  const TS_TOKEN_KEY   = 'ts_auth_token';
  const TS_USER_KEY    = 'ts_auth_user';
  const TS_BOOKMARKS_KEY = 'ts_bookmarks';

  function getToken() { return localStorage.getItem(TS_TOKEN_KEY); }
  function getUser()  {
    try { return JSON.parse(localStorage.getItem(TS_USER_KEY) || 'null'); }
    catch { return null; }
  }
  function clearAuth() {
    localStorage.removeItem(TS_TOKEN_KEY);
    localStorage.removeItem(TS_USER_KEY);
  }
  function getInitials(name) {
    return name ? name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) : '?';
  }
  function formatDate(dateStr) {
    if (!dateStr) return '—';
    return new Date(dateStr).toLocaleDateString('en-NG', { year: 'numeric', month: 'long', day: 'numeric' });
  }
  function getBookmarkCount() {
    try { return JSON.parse(localStorage.getItem(TS_BOOKMARKS_KEY) || '[]').length; }
    catch { return 0; }
  }

  function populateProfile(user) {
    const avatarEl = document.getElementById('profile-avatar');
    if (avatarEl) {
      if (user.avatarUrl) {
        avatarEl.innerHTML = `<img src="${user.avatarUrl}" alt="${user.displayName}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">`;
      } else {
        avatarEl.textContent = getInitials(user.displayName);
      }
    }

    const setText = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val || '—';
    };

    setText('profile-name',   user.displayName);
    setText('profile-email',  user.email);
    setText('detail-name',    user.displayName);
    setText('detail-email',   user.email);
    setText('detail-joined',  formatDate(user.createdAt));

    const roleEl = document.getElementById('profile-role');
    if (roleEl) roleEl.textContent = user.role || 'Member';

    const statEl = document.getElementById('stat-bookmarks');
    if (statEl) statEl.textContent = getBookmarkCount();
  }

  async function handleSignOut() {
    const token = getToken();
    if (token) {
      fetch(`${AUTH_API}/logout`, {
        method:  'POST',
        headers: { Authorization: `Bearer ${token}` },
      }).catch(() => {});
    }
    clearAuth();
    window.location.href = '/';
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const token = getToken();
    const user  = getUser();

    if (!token || !user) {
      document.getElementById('auth-gate').style.display = 'flex';
      document.getElementById('gate-signin-btn')?.addEventListener('click', () => {
        document.getElementById('auth-signin-btn')?.click();
      });
      return;
    }

    document.getElementById('profile-content').style.display = 'block';
    populateProfile(user);

    // Refresh user data from server silently
    try {
      const res = await fetch(`${AUTH_API}/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const fresh = await res.json();
        if (fresh.user) {
          localStorage.setItem('ts_auth_user', JSON.stringify(fresh.user));
          populateProfile(fresh.user);
        }
      } else {
        clearAuth();
        window.location.href = '/';
      }
    } catch { /* use cached user data silently */ }

    document.getElementById('signout-profile-btn')?.addEventListener('click', handleSignOut);
  });
</script>

<style>
  .profile-page      { min-height: 60vh; padding: 2.5rem 1rem 4rem; background: #f9fafb; }
  .page-container    { max-width: 900px; margin: 0 auto; }

  /* Auth gate */
  .auth-gate         { display: flex; justify-content: center; padding: 5rem 1rem; }
  .gate-card         { background: #fff; border-radius: 16px; padding: 3rem 2rem; text-align: center; max-width: 400px; box-shadow: 0 4px 24px rgba(0,0,0,0.07); display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .gate-card h2      { font-size: 1.3rem; font-weight: 700; color: #111; margin: 0; }
  .gate-card p       { color: #6b7280; font-size: 0.9rem; margin: 0; line-height: 1.6; }

  /* Profile header */
  .profile-header    { display: flex; align-items: center; gap: 1.5rem; background: #fff; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
  .avatar-wrap       { flex-shrink: 0; }
  .avatar-large      { width: 80px; height: 80px; border-radius: 50%; background: #dc2626; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: 800; }
  .profile-info      { display: flex; flex-direction: column; gap: 0.3rem; }
  .profile-name      { font-size: 1.5rem; font-weight: 800; color: #111; margin: 0; }
  .profile-email     { font-size: 0.9rem; color: #6b7280; margin: 0; }
  .profile-badge     { display: inline-block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #dc2626; background: #fef2f2; padding: 0.2rem 0.6rem; border-radius: 4px; width: fit-content; }

  /* Profile grid */
  .profile-grid      { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .profile-card      { background: #fff; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .card-heading      { font-size: 1rem; font-weight: 700; color: #111; margin: 0 0 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid #f3f4f6; }

  /* Detail rows */
  .detail-row        { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid #f9fafb; }
  .detail-row:last-child { border-bottom: none; }
  .detail-label      { font-size: 0.85rem; color: #9ca3af; font-weight: 600; }
  .detail-value      { font-size: 0.9rem; color: #374151; font-weight: 500; text-align: right; max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Stats */
  .stat-row          { display: flex; gap: 1rem; margin-bottom: 1.25rem; }
  .stat-box          { display: flex; flex-direction: column; align-items: center; background: #f9fafb; border-radius: 10px; padding: 1rem 1.5rem; gap: 0.2rem; }
  .stat-num          { font-size: 1.75rem; font-weight: 800; color: #dc2626; }
  .stat-label        { font-size: 0.78rem; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  /* Buttons */
  .btn-primary       { display: inline-block; background: #dc2626; color: #fff; font-weight: 700; font-size: 0.95rem; padding: 0.65rem 1.5rem; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s; }
  .btn-primary:hover { background: #b91c1c; }
  .btn-outline       { display: inline-block; border: 1.5px solid #dc2626; color: #dc2626; font-weight: 700; font-size: 0.875rem; padding: 0.55rem 1.1rem; border-radius: 8px; text-decoration: none; transition: background 0.2s; }
  .btn-outline:hover { background: #fef2f2; }

  /* Danger zone */
  .danger-card       { border: 1px solid #fecaca; grid-column: 1 / -1; }
  .danger-heading    { color: #dc2626; }
  .btn-danger        { display: flex; align-items: center; gap: 0.5rem; background: #fef2f2; border: 1.5px solid #fecaca; color: #dc2626; font-weight: 700; font-size: 0.9rem; padding: 0.6rem 1.25rem; border-radius: 8px; cursor: pointer; transition: background 0.2s; }
  .btn-danger:hover  { background: #fee2e2; }

  @media (max-width: 640px) {
    .profile-grid    { grid-template-columns: 1fr; }
    .danger-card     { grid-column: 1; }
    .profile-header  { flex-direction: column; text-align: center; }
    .profile-info    { align-items: center; }
  }
</style>
