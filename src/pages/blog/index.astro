---
import Listing from '../../layouts/Listing.astro';
import { getSortedPosts, pageCount, pageSlice } from '../../posts';

const all = await getSortedPosts();
---

<Listing
	title="All News | TownScribe"
	description="Every story published on TownScribe Media, newest first."
	heading="All News"
	posts={pageSlice(all, 1)}
	base="/blog"
	current={1}
	total={pageCount(all.length)}
/>
